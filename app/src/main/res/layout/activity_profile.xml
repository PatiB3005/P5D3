<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <!-- TOOLBAR: TYLKO STRZAŁKA -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarSettings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#2B6CB0"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="" />

    <!-- GŁÓWNA TREŚĆ (ODSUNIĘTA POD TOOLBAR) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E9EEF5"
            android:padding="20dp">

            <!-- TYTUŁ -->
            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Profil użytkownika"
                android:textAlignment="center"
                android:textColor="#000000"
                android:textSize="36sp"
                android:fontFamily="@font/montserrat_bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- AVATAR -->
            <ImageView
                android:id="@+id/avatarImage"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginTop="20dp"
                android:src="@drawable/user_avatar_blue"
                android:contentDescription="@string/user_photo_desc"
                app:layout_constraintTop_toBottomOf="@id/title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- MEDALE – etykieta -->
            <TextView
                android:id="@+id/labelMedal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/montserrat_bold"
                android:text="Zdobyte medale"
                android:textColor="#000000"
                android:textSize="18sp"
                app:layout_constraintTop_toBottomOf="@id/avatarImage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/medalsLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/labelMedal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- IMIĘ -->
            <TextView
                android:id="@+id/labelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_name"
                android:textColor="#000000"
                android:textSize="18sp"
                android:fontFamily="@font/montserrat_bold"
                app:layout_constraintTop_toBottomOf="@id/medalsLayout"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/inputName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:hint="@string/hint_name"
                android:inputType="textPersonName"
                android:autofillHints="name"
                android:maxLength="20"
                android:textColor="#000000"
                android:textColorHint="#808080"
                android:fontFamily="@font/montserrat_regular"
                android:background="@drawable/edittext_bg"
                android:padding="12dp"
                app:layout_constraintTop_toBottomOf="@id/labelName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- NAZWISKO -->
            <TextView
                android:id="@+id/labelSurname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_surname"
                android:textColor="#000000"
                android:textSize="18sp"
                android:fontFamily="@font/montserrat_bold"
                app:layout_constraintTop_toBottomOf="@id/inputName"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/inputSurname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:hint="@string/hint_surname"
                android:inputType="textPersonName"
                android:autofillHints="familyName"
                android:maxLength="60"
                android:textColor="#000000"
                android:textColorHint="#808080"
                android:fontFamily="@font/montserrat_regular"
                android:background="@drawable/edittext_bg"
                android:padding="12dp"
                app:layout_constraintTop_toBottomOf="@id/labelSurname"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- WIEK -->
            <TextView
                android:id="@+id/labelAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_age"
                android:textColor="#000000"
                android:textSize="18sp"
                android:fontFamily="@font/montserrat_bold"
                app:layout_constraintTop_toBottomOf="@id/inputSurname"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/inputAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:hint="@string/hint_age"
                android:inputType="number"
                android:autofillHints="age"
                android:maxLength="4"
                android:textColor="#000000"
                android:textColorHint="#808080"
                android:fontFamily="@font/montserrat_regular"
                android:background="@drawable/edittext_bg"
                android:padding="12dp"
                app:layout_constraintTop_toBottomOf="@id/labelAge"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- PRZYCISKI -->
            <Button
                android:id="@+id/btnEditSave"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="24dp"
                android:text="Edytuj"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textAllCaps="false"
                android:fontFamily="@font/montserrat_bold"
                app:backgroundTint="#2563EB"
                app:cornerRadius="16dp"
                app:layout_constraintTop_toBottomOf="@id/inputAge"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/backButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:text="@string/button_back"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textAllCaps="false"
                android:fontFamily="@font/montserrat_bold"
                app:backgroundTint="#3F51B5"
                app:cornerRadius="16dp"
                app:layout_constraintTop_toBottomOf="@id/btnEditSave"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <include
        android:id="@+id/popupOverlay"
        layout="@layout/view_result_popup"
        android:visibility="gone" />

</FrameLayout>
