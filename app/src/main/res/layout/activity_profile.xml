<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDF8"
    android:padding="20dp">

    <!-- LOGO -->
    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/logo_smartsenior"
        android:contentDescription="@string/logo_desc"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- AVATAR -->
    <ImageView
        android:id="@+id/avatarImage"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/user_avatar"
        android:contentDescription="@string/user_photo_desc"
        app:layout_constraintTop_toBottomOf="@id/logoImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <!-- MEDALE -->
    <LinearLayout
        android:id="@+id/medalsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/avatarImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp">

        <ImageView
            android:id="@+id/medal1"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/medal_silver"
            android:layout_margin="4dp"
            android:contentDescription="@string/medal1_desc" />

        <ImageView
            android:id="@+id/medal2"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/medal_silver"
            android:layout_margin="4dp"
            android:contentDescription="@string/medal2_desc" />

        <ImageView
            android:id="@+id/medal3"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/medal_silver"
            android:layout_margin="4dp"
            android:contentDescription="@string/medal3_desc" />
    </LinearLayout>

    <!-- ETYKIETY I POLA -->
    <TextView
        android:id="@+id/labelName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_name"
        android:textStyle="bold"
        android:textColor="#000000"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/medalsLayout"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/inputName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/hint_name"
        android:background="@drawable/edittext_border"
        android:padding="10dp"
        android:textColorHint="#999999"
        android:inputType="textPersonName"
        android:autofillHints="name"
        app:layout_constraintTop_toBottomOf="@id/labelName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/labelSurname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_surname"
        android:textStyle="bold"
        android:textColor="#000000"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/inputName"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/inputSurname"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/hint_surname"
        android:background="@drawable/edittext_border"
        android:padding="10dp"
        android:textColorHint="#999999"
        android:inputType="textPersonName"
        android:autofillHints="familyName"
        app:layout_constraintTop_toBottomOf="@id/labelSurname"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/labelAge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_age"
        android:textStyle="bold"
        android:textColor="#000000"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/inputSurname"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/inputAge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/hint_age"
        android:background="@drawable/edittext_border"
        android:padding="10dp"
        android:textColorHint="#999999"
        android:inputType="number"
        android:autofillHints="age"
        app:layout_constraintTop_toBottomOf="@id/labelAge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- PRZYCISK -->
    <Button
        android:id="@+id/btnEditSave"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Edytuj"
        android:backgroundTint="#FF7A00"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/inputAge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- PRZYCISK WRÓĆ DO MENU -->
    <Button
        android:id="@+id/backButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/button_back"
        android:backgroundTint="#FF7A00"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnEditSave"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>
