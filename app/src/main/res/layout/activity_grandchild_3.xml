<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF3FF">

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SCENARIUSZ"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/imgBubble"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_speech_bubble"
        android:adjustViewBounds="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/textTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Muszę natychmiast zapłacić kaucję, inaczej będę mieć poważne kłopoty. Czy możesz mi dać pieniądze albo zrobić przelew?"
        android:textSize="16sp"
        android:padding="16dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/imgBubble"
        app:layout_constraintBottom_toBottomOf="@id/imgBubble"
        app:layout_constraintStart_toStartOf="@id/imgBubble"
        app:layout_constraintEnd_toEndOf="@id/imgBubble" />

    <!-- avatar po lewej -->
    <ImageView
        android:id="@+id/imgGrandchild"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_grandchild"
        android:layout_marginTop="12dp"
        android:layout_marginStart="32dp"
        app:layout_constraintTop_toBottomOf="@id/imgBubble"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textQuestion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Co robisz?"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/bg_scenario_question"
        android:paddingVertical="10dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/imgGrandchild"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textAnswerA"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="A) „Tak, spróbuję ci pomóc.”"
        android:textSize="14sp"
        android:background="@drawable/bg_scenario_answer"
        android:paddingHorizontal="18dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/textQuestion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textAnswerB"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="B) „Najpierw zadzwonię do rodziny / na policję.”"
        android:textSize="14sp"
        android:background="@drawable/bg_scenario_answer"
        android:paddingHorizontal="18dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/textAnswerA"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/imgHangup"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_call_end"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
