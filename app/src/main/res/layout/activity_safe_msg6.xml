<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor2">

    <!-- Tytuł -->
    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CZĘŚĆ TEORETYCZNA"
        android:textColor="#000"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"/>

    <!-- Podtytuł -->
    <TextView
        android:id="@+id/headerSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BEZPIECZNE WIADOMOŚCI JAK SIĘ BRONIĆ?"
        android:textColor="#000"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@id/headerTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="2dp"/>

    <!-- Ramka z obrazem -->
    <FrameLayout
        android:id="@+id/imageFrame"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:background="@drawable/border_rounded"
        android:padding="6dp"
        app:layout_constraintTop_toBottomOf="@id/headerSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp">

        <ImageView
            android:id="@+id/headerImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/img_internet_comm"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <!-- Pierwszy blok tekstu -->
    <TextView
        android:id="@+id/contentText1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bluer_box_radius"
        android:textColor="#000"
        android:padding="8dp"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/imageFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:text="1. Nie klikaj linków w podejrzanych SMS/wiadomościach" />

    <!-- Drugi blok tekstu -->
    <TextView
        android:id="@+id/contentText2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/blue_box_radius"
        android:padding="8dp"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000"
        app:layout_constraintTop_toBottomOf="@id/contentText1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:text="2. Nigdy nie podawaj kodów OTP, PIN-ów ani haseł przez SMS lub w odpowiedzi na wiadomość. Prawdziwy bank nie poprosi Cię o kod przez SMS w celu „weryfikacji” przy rozmowie telefonicznej." />

    <!-- Trzeci blok tekstu -->
    <TextView
        android:id="@+id/contentText3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bluer_box_radius"
        android:padding="8dp"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000"
        app:layout_constraintTop_toBottomOf="@id/contentText2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:text="3. Sprawdź adres strony zanim zalogujesz się: fałszywe strony często mają literówki, dodatkowe znaki lub nietypowe domeny. Jeśli masz wątpliwość — nie loguj się." />

    <!-- Przyciski -->
    <LinearLayout
        android:id="@+id/buttonsLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="24dp"
            android:background="@drawable/rounded_button"
            android:textColor="#161010"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="Wstecz"/>

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/rounded_button"
            android:textColor="#161010"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="Dalej"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
