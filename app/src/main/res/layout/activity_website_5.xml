<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#BFDBFE"
    android:padding="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Wyśrodkowany tytuł -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oszustwo czy nie?"
            android:padding="5dp"
            android:textStyle="bold"
            android:textSize="36sp"
            android:gravity="center"
            android:textColor="#000000"
            android:layout_marginBottom="5dp" />

        <!-- KARTA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_dark"
            android:padding="15dp"
            android:layout_margin="8dp"
            android:elevation="8dp">

            <!-- Pasek adresu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/url_box"
                android:paddingHorizontal="20dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/allegro_logo"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/addressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="www.alllegro.pl"
                    android:textColor="#000000"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- ZDJĘCIE -->
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:maxWidth="250dp"
                android:scaleType="fitCenter"
                android:src="@drawable/opony"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- Tytuł -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Opony zimowe nówki"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <!-- Cena -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cena: 100 zł"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Opinie -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Opinie"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="5dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/profilowe"
                    android:layout_marginEnd="16dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="user1234"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Brak opinii"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- OPIS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Opis"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Podaj mi swój adres i wysyłka prawie odrazu!"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <!-- Przyciski -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnFake"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:textSize="15sp"
                android:text="FAŁSZYWA"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#D92D20"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/btnReal"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:textSize="15sp"
                android:text="PRAWDZIWA"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#12B76A"
                android:layout_marginStart="5dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
