<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oszustwo czy nie?"
                android:textColor="#1A202C"
                android:textSize="34sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/textSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oceń wiarygodność strony"
                android:textColor="#4A5568"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/websiteCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="24dp"
                app:cardUseCompatPadding="true"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#111827">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:gravity="center_horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:background="@drawable/rounded_dark"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="18dp">

                        <ImageView
                            android:id="@+id/logoSite"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/allegro_logo"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/addressBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="www.alllegro.pl"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:fontFamily="@font/montserrat_regular" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/productImage"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:src="@drawable/opony"
                        android:scaleType="centerCrop"
                        android:background="@drawable/rounded_image"
                        android:clipToOutline="true"
                        android:outlineProvider="background"
                        android:layout_marginBottom="14dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/productTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Opony zimowe nówki"
                        android:textSize="24sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="start"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/productPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cena: 100 zł"
                        android:textSize="22sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="start"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:id="@+id/reviewsHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Opinie"
                        android:textSize="20sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="start"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <ImageView
                            android:id="@+id/reviewAvatar"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/profilowe"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/reviewUser"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="user1234"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:fontFamily="@font/montserrat_regular"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:id="@+id/reviewText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Brak opinii"
                                android:textColor="#CBD5E1"
                                android:textSize="18sp"
                                android:fontFamily="@font/montserrat_regular" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/descHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Opis"
                        android:textSize="20sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="start" />

                    <TextView
                        android:id="@+id/descBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Podaj mi swój adres i wysyłka prawie odrazu!"
                        android:textColor="#CBD5E1"
                        android:textSize="18sp"
                        android:fontFamily="@font/montserrat_regular"
                        android:gravity="start"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/bottomDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#D9E2EF"
        app:layout_constraintBottom_toTopOf="@id/bottomContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:baselineAligned="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFake"
                android:layout_width="0dp"
                android:layout_height="74dp"
                android:layout_weight="1"
                android:text="Fałszywa"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/montserrat_bold"
                app:backgroundTint="#2B6CB0"
                app:cornerRadius="24dp"
                android:layout_marginEnd="10dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="22sp"
                android:autoSizeStepGranularity="1sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReal"
                android:layout_width="0dp"
                android:layout_height="74dp"
                android:layout_weight="1"
                android:text="Prawdziwa"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/montserrat_bold"
                app:backgroundTint="#2B6CB0"
                app:cornerRadius="24dp"
                android:layout_marginStart="10dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="22sp"
                android:autoSizeStepGranularity="1sp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="12dp"
            android:text="Przejdź dalej"
            android:textAllCaps="false"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/montserrat_bold"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="24dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/popupOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:visibility="gone"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="18dp"
            android:minWidth="325dp"
            app:cardCornerRadius="24dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="10dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:orientation="vertical"
                android:padding="22dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/titleFalse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:visibility="visible"
                    android:text="Niepoprawna odpowiedź"
                    android:fontFamily="@font/montserrat_bold"
                    android:textColor="#1A202C"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/titleTrue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:visibility="gone"
                    android:text="Poprawna odpowiedź"
                    android:fontFamily="@font/montserrat_bold"
                    android:textColor="#1A202C"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/popupIntro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:text="Ta strona ma elementy wskazujące na oszustwo:"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="center"
                    android:textColor="#4A5568"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:id="@+id/popupList"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:text="• Podejrzany adres strony. Adres posiada literówkę"
                        android:fontFamily="@font/montserrat_regular"
                        android:textColor="#4A5568"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:text="• Cena podejrzanie niska. Komplet opon za 100 zł jest nierealny"
                        android:fontFamily="@font/montserrat_regular"
                        android:textColor="#4A5568"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:text="• Opis sugeruje pośpiech. „Podaj swój adres i wysyłka od razu!” może wskazywać na próbę wyłudzenia danych"
                        android:fontFamily="@font/montserrat_regular"
                        android:textColor="#4A5568"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:text="• Brak opinii i uboga karta produktu. To częsty sygnał fałszywej strony"
                        android:fontFamily="@font/montserrat_regular"
                        android:textColor="#4A5568"
                        android:layout_marginBottom="8dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOk"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="14dp"
                    android:text="OK"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="@font/montserrat_bold"
                    app:backgroundTint="#2B6CB0"
                    app:cornerRadius="24dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
