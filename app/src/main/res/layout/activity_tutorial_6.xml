<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <!-- Scroll z treścią -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp">

            <!-- minimalny luz u góry -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.02" />

            <!-- Tytuł -->
            <TextView
                android:id="@+id/text_tytul"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gratulacje!"
                android:textColor="#1A202C"
                android:textSize="36sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:textAlignment="center"
                android:layout_marginBottom="8dp" />

            <!-- Krótszy opis -->
            <TextView
                android:id="@+id/text_opis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ukończyłeś samouczek Smart Senior.\nMożesz teraz rozpocząć naukę w aplikacji."
                android:textColor="#4A5568"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:textAlignment="center"
                android:lineSpacingExtra="6dp"
                android:layout_marginBottom="10dp" />

            <!-- 2 krótkie zdania -->
            <TextView
                android:id="@+id/text_dopisek1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Powodzenia!"
                android:textColor="#4A5568"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:textAlignment="center"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/text_dopisek2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="W razie potrzeby zawsze możesz wrócić do samouczka."
                android:textColor="#4A5568"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:textAlignment="center"
                android:lineSpacingExtra="6dp"
                android:layout_marginBottom="12dp" />

            <!-- Ikona (większa, ale bez ryzyka przycięcia) -->
            <ImageView
                android:id="@+id/img_hat"
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:alpha="0.9"
                app:tint="#2B6CB0"
                android:src="@drawable/ic_hat"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <!-- minimalny oddech na dole -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.03" />

        </LinearLayout>
    </ScrollView>

    <!-- Separator -->
    <View
        android:id="@+id/separator"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#D9E2EF"
        app:layout_constraintBottom_toTopOf="@id/bottomContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Dół: przycisk zawsze widoczny -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_zakoncz"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="Zakończ"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="20dp"
            app:strokeWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
