<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDF2F7">

    <!-- DUŻA KARTA (nagłówek) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginTop="50dp"
        app:cardBackgroundColor="#93C5FD"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="30dp"
            android:paddingBottom="30dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Ktoś prosi o podanie\nkodu z SMS-a."
            android:textColor="#000000"
            android:textSize="30sp"
            android:gravity="center"
            android:fontFamily="@font/montserrat_bold" />
    </com.google.android.material.card.MaterialCardView>


    <!-- KARTA #1 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="30dp"
        app:cardBackgroundColor="#BFDBFE"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/cardTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="Nie klikaj w linki z wiadomości."
            android:textSize="22sp"
            android:textColor="#000"
            android:gravity="center"
            android:fontFamily="@font/montserrat_regular"/>
    </com.google.android.material.card.MaterialCardView>


    <!-- KARTA #2 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="#BFDBFE"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/card1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="Zawsze sam oddzwoń na oficjalny numer."
            android:textSize="22sp"
            android:gravity="center"
            android:textColor="#000"
            android:fontFamily="@font/montserrat_regular"/>
    </com.google.android.material.card.MaterialCardView>


    <!-- KARTA #3 (POPRAWNA) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="#BFDBFE"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/card2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="Nigdy nie podawaj kodów ani haseł."
            android:textSize="22sp"
            android:gravity="center"
            android:textColor="#000"
            android:fontFamily="@font/montserrat_regular"/>
    </com.google.android.material.card.MaterialCardView>


    <!-- KARTA #4 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="#BFDBFE"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/card3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="Zapytaj kogoś z rodziny lub zaufaną osobę."
            android:textSize="22sp"
            android:gravity="center"
            android:textColor="#000"
            android:fontFamily="@font/montserrat_regular"/>
    </com.google.android.material.card.MaterialCardView>


    <!-- PRZYCISK DALEJ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="170dp"
        android:layout_height="56dp"
        android:text="Dalej"
        android:textSize="22sp"
        android:textColor="#000"
        android:textAllCaps="false"
        android:fontFamily="@font/montserrat_bold"
        app:backgroundTint="#9D9FB0"
        app:cornerRadius="16dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
