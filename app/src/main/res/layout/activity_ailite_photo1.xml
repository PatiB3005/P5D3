<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <!-- Tytuł -->
    <TextView
        android:id="@+id/textTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="AI Lite"
        android:textSize="42sp"
        android:textColor="#1A202C"
        android:gravity="center"
        android:fontFamily="@font/montserrat_bold"
        android:layout_marginTop="28dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Podtytuł -->
    <TextView
        android:id="@+id/textSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Prawdziwe vs AI"
        android:textSize="26sp"
        android:textColor="#4A5568"
        android:gravity="center"
        android:fontFamily="@font/montserrat_bold"
        android:layout_marginTop="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/textTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Obrazek: większy -->
    <ImageView
        android:id="@+id/theoryImage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/yesorno"
        android:contentDescription="Obraz teorii"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:maxHeight="420dp"
        app:layout_constraintTop_toBottomOf="@id/textSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Treść: niżej + bliżej przycisku -->
    <TextView
        android:id="@+id/textContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Twoim zadaniem będzie wybranie, czy zdjęcie jest prawdziwe, czy zostało stworzone przez sztuczną inteligencję"
        android:textSize="24sp"
        android:textColor="#1A202C"
        android:lineSpacingExtra="7dp"
        android:gravity="center"
        android:fontFamily="@font/montserrat_regular"
        android:layout_marginTop="18dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/theoryImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Przycisk -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Rozpocznij"
        android:textAllCaps="false"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/montserrat_bold"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="18dp"
        app:backgroundTint="#2B6CB0"
        app:cornerRadius="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
