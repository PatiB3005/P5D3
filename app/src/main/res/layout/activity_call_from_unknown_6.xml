<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <!-- ✅ Tor scrolla startuje pod górnym paskiem -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="56dp" />

    <!-- Scroll -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topGuide"
        app:layout_constraintBottom_toTopOf="@id/bottomDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="22dp"
            android:paddingBottom="18dp">

            <!-- Tytuł główny -->
            <TextView
                android:id="@+id/headerMain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TELEFON OD PODEJRZANEGO NIEZNAJOMEGO"
                android:textColor="#1A202C"
                android:textSize="32sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:layout_marginTop="8dp" />

            <!-- Podtytuł -->
            <TextView
                android:id="@+id/headerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JAK DZIAŁAJĄ OSZUŚCI (CZĘŚĆ 1)"
                android:textColor="#1A202C"
                android:textSize="28sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Część teoretyczna"
                android:textColor="#4A5568"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp" />

            <!-- OBRAZEK -->
            <ImageView
                android:id="@+id/headerImage"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_call_from_unknown6"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:padding="4dp"
                android:contentDescription="@null" />

            <!-- Blok 1 -->
            <TextView
                android:id="@+id/contentText1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/blue_box_radius"
                android:padding="18dp"
                android:textSize="22sp"
                android:lineSpacingExtra="7dp"
                android:textColor="#1A202C"
                android:fontFamily="@font/montserrat_regular"
                android:text="Oszuści wykorzystują znane mechanizmy psychologiczne, aby przejąć kontrolę nad rozmową i skłonić do szybkiej, nieprzemyślanej decyzji. Oto przykłady:"
                android:layout_marginBottom="14dp" />

            <!-- ITEM 1 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#D9E2EF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#E7F0FF">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="1"
                            android:textSize="18sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="#2B6CB0"
                            android:gravity="center" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/contentText2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Podszywają się pod autorytet, by wzbudzić zaufanie i uśpić czujność."
                        android:textColor="#1A202C"
                        android:textSize="21sp"
                        android:lineSpacingExtra="6dp"
                        android:fontFamily="@font/montserrat_bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ITEM 2 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#D9E2EF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#E7F0FF">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="2"
                            android:textSize="18sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="#2B6CB0"
                            android:gravity="center" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/contentText3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Tworzą presję czasu, mówiąc, że musisz działać natychmiast po to, byś nie miał chwili na zastanowienie."
                        android:textColor="#1A202C"
                        android:textSize="21sp"
                        android:lineSpacingExtra="6dp"
                        android:fontFamily="@font/montserrat_bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ITEM 3 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#D9E2EF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#E7F0FF">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="3"
                            android:textSize="18sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="#2B6CB0"
                            android:gravity="center" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/contentText4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Silnie grają emocjami, wzbudzając strach, litość lub troskę, bo emocje osłabiają logiczne myślenie."
                        android:textColor="#1A202C"
                        android:textSize="21sp"
                        android:lineSpacingExtra="6dp"
                        android:fontFamily="@font/montserrat_bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ITEM 4 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#D9E2EF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#E7F0FF">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="4"
                            android:textSize="18sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="#2B6CB0"
                            android:gravity="center" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/contentText5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Nadmiernie się przymilają, stosując pochlebstwa i przesadną uprzejmość, aby budować fałszywą więź."
                        android:textColor="#1A202C"
                        android:textSize="21sp"
                        android:lineSpacingExtra="6dp"
                        android:fontFamily="@font/montserrat_bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />
        </LinearLayout>
    </ScrollView>

    <!-- ✅ Gruby niebieski “scrollbar” -->
    <View
        android:id="@+id/customScrollThumb"
        android:layout_width="12dp"
        android:layout_height="120dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="6dp"
        android:alpha="0.85"
        android:background="#2B6CB0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topGuide"
        app:layout_constraintBottom_toTopOf="@id/bottomDivider"
        app:layout_constraintVertical_bias="0" />

    <!-- ✅ separator -->
    <View
        android:id="@+id/bottomDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#D9E2EF"
        app:layout_constraintBottom_toTopOf="@id/bottomButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom buttons -->
    <LinearLayout
        android:id="@+id/bottomButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:baselineAligned="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:layout_weight="1"
            android:text="Wstecz"
            android:textAllCaps="false"
            android:textSize="20sp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="22dp" />

        <Space
            android:layout_width="14dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:layout_weight="1"
            android:text="Dalej"
            android:textAllCaps="false"
            android:textSize="20sp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="22dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
