<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F0FA">

    <!-- NIEBIESKI PASEK -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#2B6CB0"
        app:title="" />

    <!-- STRZAŁKA COFANIA -->
    <ImageButton
        android:id="@+id/btnBackToMain"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_arrow_back_black"
        android:padding="12dp"
        android:scaleType="center"
        app:tint="#FFFFFF"
        android:contentDescription="@string/cd_back_to_main" />

    <!-- TREŚĆ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- PRZYCISK: WRÓĆ DO SAMOUCZKA -->
            <!-- widoczność sterowana w kodzie -->
            <Button
                android:id="@+id/button_back_to_tutorial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wróć do samouczka"
                android:textSize="16sp"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2B6CB0"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:layout_marginBottom="24dp"
                android:visibility="gone"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/textModulesHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menu modułów"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/textColor"
                android:layout_marginBottom="32dp" />

            <!-- Moduł 1 -->
            <LinearLayout
                android:id="@+id/btnSafeMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/module_card"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                android:layout_marginHorizontal="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/safe_messages_banner"
                    android:background="@drawable/rounded_image"
                    android:clipToOutline="true" />

                <TextView
                    android:id="@+id/textModule1Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bezpieczne wiadomości"
                    android:fontFamily="@font/montserrat_bold"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/textModule1Description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="W tym module dowiesz się, jak rozpoznawać techniki oszustów używających fałszywych wiadomości (SMS, e-mail, komunikatory) oraz poznasz konkretne kroki, by skutecznie chronić swoje konta, dane i pieniądze."
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/montserrat_regular"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp" />

                <ProgressBar
                    android:id="@+id/progressModule1"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/module_progress_bar" />

                <TextView
                    android:id="@+id/textModule1ProgressLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="Postęp: 0%"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Moduł 2 -->
            <LinearLayout
                android:id="@+id/btnCallFromAnUnknown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/module_card"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                android:layout_marginHorizontal="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/call_from_a_unknown_person_banner"
                    android:background="@drawable/rounded_image"
                    android:clipToOutline="true" />

                <TextView
                    android:id="@+id/textModule2Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Telefon od podejrzanego nieznajomego"
                    android:fontFamily="@font/montserrat_bold"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/textModule2Description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="W tym module nauczysz się rozpoznawać podejrzane rozmowy telefoniczne i bezpiecznie na nie reagować."
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/montserrat_regular"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp" />

                <ProgressBar
                    android:id="@+id/progressModule2"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/module_progress_bar" />

                <TextView
                    android:id="@+id/textModule2ProgressLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="Postęp: 0%"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Moduł 3 -->
            <LinearLayout
                android:id="@+id/btnShoppingOnline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/module_card"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                android:layout_marginHorizontal="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_online_shopping"
                    android:background="@drawable/rounded_image"
                    android:clipToOutline="true" />





                <TextView
                    android:id="@+id/textModule3Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zakupy Online"
                    android:fontFamily="@font/montserrat_bold"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/textModule3Description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="W tym module nauczysz się, jak bezpiecznie robić zakupy w internecie. Poznasz typowe triki oszustów w fałszywych sklepach i ogłoszeniach, dowiesz się jak sprawdzać sprzedawcę, unikać podejrzanych linków oraz chronić swoje dane i pieniądze podczas płatności."
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/montserrat_regular"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp" />

                <ProgressBar
                    android:id="@+id/progressModule3"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/module_progress_bar" />

                <TextView
                    android:id="@+id/textModule3ProgressNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="Postęp: 0%"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />


            </LinearLayout>
            <!-- Fake News -->
            <LinearLayout
                android:id="@+id/btnFakeNewsModule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/module_card"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                android:layout_marginHorizontal="8dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:src="@drawable/fake_news_banner"
                android:background="@drawable/rounded_image"
                android:clipToOutline="true" />

            <TextView
                android:id="@+id/textFakeNewsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fake news"
                android:fontFamily="@font/montserrat_bold"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textFakeNewsDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sprawdź swoją odporność na fake newsy. W module poznasz podstawy rozpoznawania fałszywych informacji oraz sprawdzisz w praktyce, jak radzisz sobie z nimi w codziennych sytuacjach."
                android:textColor="#FFFFFF"
                android:fontFamily="@font/montserrat_regular"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <ProgressBar
                android:id="@+id/progressFakeNews"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:progress="0"
                android:max="100"
                android:progressDrawable="@drawable/module_progress_bar" />

                <TextView
                    android:id="@+id/textFakeNewsProgressLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="Postęp: 0%"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- AI Lite -->
            <LinearLayout
                android:id="@+id/btnAiLite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/module_card"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                android:layout_marginHorizontal="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ailogo"
                    android:background="@drawable/rounded_image"
                    android:clipToOutline="true" />

                <TextView
                    android:id="@+id/textAiTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Lite"
                    android:fontFamily="@font/montserrat_bold"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/textAiDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="W tym module poćwiczysz rozpoznawanie zdjęć wygenerowanych przez AI od tych rzeczywistych. Sprawdzisz, czy potrafisz odróżnić prawdę od tych wygenerowanych."
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/montserrat_regular"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp" />

                <ProgressBar
                    android:id="@+id/progressAiLite"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/module_progress_bar" />

                <TextView
                    android:id="@+id/textAiProgressLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="Postęp: 0%"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
