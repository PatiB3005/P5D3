<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#E9EEF5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="18dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYMULACJA\nROZMOWY"
            android:gravity="center"
            android:fontFamily="@font/montserrat_bold"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/textMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:text="NEGATYWNY WYNIK\n(utrata oszczędności)"
            android:textSize="22sp"
            android:textColor="#D80000"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:padding="24dp"
            android:fontFamily="@font/montserrat_bold"
            android:background="@drawable/edittext_bg"/>

        <TextView
            android:id="@+id/textMessage2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:text="Przekazałaś/łeś pieniądze obcej osobie, wierząc, że pomagasz wnukowi. Okazało się, że to był oszust."
            android:textSize="22sp"
            android:textColor="#000000"
            android:lineSpacingExtra="4dp"
            android:padding="24dp"
            android:fontFamily="@font/montserrat_regular"
            android:background="@drawable/edittext_bg"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="200dp"
            android:layout_height="74dp"
            android:layout_marginTop="15dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:text="Dalej"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:fontFamily="@font/montserrat_bold"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="24dp"/>

    </LinearLayout>

</ScrollView>
