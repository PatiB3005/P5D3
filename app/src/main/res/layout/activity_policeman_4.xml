<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <!-- Nagłówek -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SCENARIUSZ"
        android:textStyle="bold"
        android:textSize="22sp"
        android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Dymek -->
    <ImageView
        android:id="@+id/bubble"
        android:layout_width="260dp"
        android:layout_height="180dp"
        android:src="@drawable/ic_speech_bubble"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Tekst w dymku -->
    <TextView
        android:id="@+id/message"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:text="Pani konto może być atakowane. Proszę się nie rozłączać, połączę Panią z naszym dyżurnym, który powie, co dalej zrobić."
        android:textSize="14sp"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="@id/bubble"
        app:layout_constraintBottom_toBottomOf="@id/bubble"
        app:layout_constraintStart_toStartOf="@id/bubble"
        app:layout_constraintEnd_toEndOf="@id/bubble"/>

    <!-- Policjant -->
    <ImageView
        android:id="@+id/policeman"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_policeman"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/bubble"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Co robisz -->
    <TextView
        android:id="@+id/question"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Co robisz?"
        android:textStyle="bold"
        android:textSize="18sp"
        android:background="#C9E4FF"
        android:padding="14dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/policeman"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Odp A -->
    <TextView
        android:id="@+id/answerA"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="A) „Dobrze, proszę połączyć.”"
        android:textSize="16sp"
        android:background="#D8E8FF"
        android:padding="14dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/question"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Czerwony przycisk -->
    <ImageView
        android:id="@+id/hangup"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_call_end"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/answerA"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
