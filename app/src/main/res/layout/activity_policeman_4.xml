<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF3FF">

    <!-- Tytuł -->
    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SCENARIUSZ"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/imgBubble"
        android:layout_width="0dp"
        android:layout_height="300dp"
        android:src="@drawable/ic_speech_bubble"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/textTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Pani konto może być atakowane. Proszę się nie rozłączać, połączę Panią z naszym dyżurnym, który powie, co dalej zrobić."
        android:textSize="16sp"
        android:padding="20dp"
        android:gravity="center"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintTop_toTopOf="@id/imgBubble"
        app:layout_constraintBottom_toBottomOf="@id/imgBubble"
        app:layout_constraintStart_toStartOf="@id/imgBubble"
        app:layout_constraintEnd_toEndOf="@id/imgBubble" />

    <!-- Avatar – jak we wnuczku (72dp, po lewej) -->
    <ImageView
        android:id="@+id/imgPoliceman"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_policeman"
        android:layout_marginTop="12dp"
        android:layout_marginStart="32dp"
        app:layout_constraintTop_toBottomOf="@id/imgBubble"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Pytanie – identyczne jak w Wnuczku -->
    <TextView
        android:id="@+id/textQuestion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Co robisz?"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/bg_scenario_question"
        android:paddingVertical="10dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintTop_toBottomOf="@id/imgPoliceman"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Odpowiedź A -->
    <TextView
        android:id="@+id/textAnswerA"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="A) „Dobrze, proszę połączyć.”"
        android:textSize="14sp"
        android:background="@drawable/bg_scenario_answer"
        android:paddingHorizontal="18dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintTop_toBottomOf="@id/textQuestion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Przycisk rozłączenia – styl wnuczka -->
    <ImageView
        android:id="@+id/declineCall"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/ic_decline_call"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
