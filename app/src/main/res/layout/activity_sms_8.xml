<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5"
    tools:context=".ui.moduleMenu.modules.SmsEmailActivity">


    <!-- Scroll content -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="22dp"
            android:paddingBottom="40dp">

            <!-- Header -->
            <TextView
                android:id="@+id/titleSafeMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bezpieczne\nwiadomości"
                android:textColor="#1A202C"
                android:textSize="36sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:textAlignment="center"
                android:includeFontPadding="false"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/titleTestPart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Część testowa"
                android:textColor="#4A5568"
                android:textSize="24sp"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:textAlignment="center"
                android:includeFontPadding="false"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <!-- OBRAZ MAILA (w karcie -> ładne zaokrąglenie i ramka) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/emailImageCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#D9E2EF"
                app:cardBackgroundColor="#FFFFFF">

                <ImageView
                    android:id="@+id/emailImage"
                    android:layout_width="match_parent"
                    android:layout_height="380dp"
                    android:src="@drawable/ic_fake_email_scam"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:padding="12dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Karta pytania -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/questionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#BFDBFE"
                app:strokeWidth="1dp"
                app:strokeColor="#A7C7F7"
                android:stateListAnimator="@null">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="22dp">

                    <TextView
                        android:id="@+id/questionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dostajesz maila, który zaczyna się w powyższy sposób. Czy powinieneś odpowiadać na niego?"
                        android:textColor="#1A202C"
                        android:textSize="24sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="5dp"
                        android:layout_marginBottom="18dp" />

                    <!-- TAK / NIE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:baselineAligned="false">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/yesButton"
                            android:layout_width="0dp"
                            android:layout_height="82dp"
                            android:layout_weight="1"
                            android:text="TAK"
                            android:textAllCaps="false"
                            android:textSize="25sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#2B6CB0"
                            app:cornerRadius="26dp"
                            app:rippleColor="#00000000"
                            android:elevation="0dp"
                            android:stateListAnimator="@null"
                            android:layout_marginEnd="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/noButton"
                            android:layout_width="0dp"
                            android:layout_height="82dp"
                            android:layout_weight="1"
                            android:text="NIE"
                            android:textAllCaps="false"
                            android:textSize="25sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#2B6CB0"
                            app:cornerRadius="26dp"
                            app:rippleColor="#00000000"
                            android:elevation="0dp"
                            android:stateListAnimator="@null"
                            android:layout_marginStart="12dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dodatkowy oddech na samym dole -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="18dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
