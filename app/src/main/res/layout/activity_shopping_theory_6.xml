<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <!-- Scrollowana część treści -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/buttonsContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- Tytuł -->
            <TextView
                android:id="@+id/textTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bezpieczne metody\npłatności"
                android:textColor="#1A202C"
                android:textSize="34sp"
                android:gravity="center"
                android:fontFamily="@font/montserrat_bold"
                android:layout_marginBottom="20dp"/>

            <!-- Obrazek -->
            <ImageView
                android:id="@+id/theoryImage"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:src="@drawable/ic_payment_secure"
                android:layout_marginBottom="20dp"/>

            <!-- Tekst – uproszczony dla seniorów -->
            <TextView
                android:id="@+id/textContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wybieraj tylko bezpieczne metody płatności:\n\n• Najbezpieczniej płacić kartą lub jednorazowym kodem BLIK (działa tylko kilka minut).\n• Unikaj przelewów „na konto”, szczególnie jeśli pierwszy raz widzisz sklep.\n• Nigdy nie podawaj nikomu kodów SMS do płatności – nawet jeśli ktoś mówi, że pomaga.\n• Jeśli sklep wymaga wyłącznie przedpłaty przelewem – to bardzo podejrzane.\n• Bezpieczniej płacić przez pośredników (np. PayU, Przelewy24) – pieniądze są wtedy chronione."
                android:textSize="22sp"
                android:textColor="#1A202C"
                android:fontFamily="@font/montserrat_regular"
                android:lineSpacingExtra="6dp"
                android:layout_marginBottom="20dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Przyciski na dole -->
    <LinearLayout
        android:id="@+id/buttonsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Wstecz"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:fontFamily="@font/montserrat_bold"
            app:backgroundTint="#9D9FB0"
            app:cornerRadius="16dp"
            android:layout_marginEnd="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Dalej"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:fontFamily="@font/montserrat_bold"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="16dp"
            android:layout_marginStart="12dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
