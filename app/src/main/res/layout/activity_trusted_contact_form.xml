<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <!-- NIEBIESKI PASEK ZE STRZAŁKĄ -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#2B6CB0"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="" />

    <!-- TREŚĆ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:fillViewport="true"
        android:background="#E9EEF5">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp">

            <!-- TYTUŁ -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Dodaj kontakt"
                android:textSize="30sp"
                android:textColor="#1A202C"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- AVATAR -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/avatarCircle"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="18dp"
                app:cardCornerRadius="60dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imgAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvInitials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/initials_placeholder"
                        android:textSize="42sp"
                        android:textColor="#2B6CB0"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DODAJ ZDJĘCIE -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickPhoto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="74dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="Dodaj zdjęcie (opcjonalnie)"
                android:textAllCaps="false"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#2B6CB0"
                app:cornerRadius="22dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/avatarCircle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- IMIĘ -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:hint="Imię / Nazwa kontaktu"
                app:hintTextColor="#2B6CB0"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="#FFFFFF"
                app:boxStrokeColor="#2B6CB0"
                app:boxCornerRadiusTopStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusBottomEnd="18dp"
                app:layout_constraintTop_toBottomOf="@id/btnPickPhoto"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:fontFamily="@font/montserrat_regular"
                    android:minHeight="82dp"
                    android:padding="16dp"
                    android:textColor="#000000" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- TELEFON -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:hint="Numer telefonu"
                app:hintTextColor="#2B6CB0"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="#FFFFFF"
                app:boxStrokeColor="#2B6CB0"
                app:boxCornerRadiusTopStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusBottomEnd="18dp"
                app:layout_constraintTop_toBottomOf="@id/tilName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textSize="22sp"
                    android:fontFamily="@font/montserrat_regular"
                    android:minHeight="82dp"
                    android:padding="16dp"
                    android:textColor="#000000" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ZAPISZ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:text="Zapisz"
                android:textAllCaps="false"
                android:textSize="26sp"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#2B6CB0"
                app:cornerRadius="22dp"
                android:layout_marginTop="22dp"
                app:layout_constraintTop_toBottomOf="@id/tilPhone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ANULUJ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:text="Anuluj"
                android:textAllCaps="false"
                android:textSize="24sp"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#1A202C"
                app:backgroundTint="#CBD5E0"
                app:cornerRadius="22dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="18dp"
                app:layout_constraintTop_toBottomOf="@id/btnSave"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</FrameLayout>
