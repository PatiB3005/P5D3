<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center"
        android:layout_marginTop="24dp">

        <!-- Ikona -->
        <ImageView
            android:id="@+id/summaryIcon"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/ic_quiz_summary"
            android:layout_marginBottom="32dp"/>

        <!-- Wynik -->
        <TextView
            android:id="@+id/summaryScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Twój wynik: 0/6"
            android:textSize="30sp"
            android:textColor="#1A202C"
            android:fontFamily="@font/montserrat_bold"
            android:layout_marginBottom="16dp"/>

        <!-- Komunikat -->
        <TextView
            android:id="@+id/summaryMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Podsumowanie"
            android:textSize="22sp"
            android:textColor="#1A202C"
            android:gravity="center"
            android:fontFamily="@font/montserrat_regular"
            android:layout_marginBottom="32dp"/>

        <!-- Przycisk zakończenia -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinish"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="Zakończ"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:fontFamily="@font/montserrat_bold"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="20dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
