<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF2FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Nagłówek -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CZĘŚĆ TESTOWA"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BEZPIECZNE WIADOMOŚCI"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Obraz wiadomości -->
        <ImageView
            android:id="@+id/testQuestionImage"
            android:layout_width="260dp"
            android:layout_height="300dp"
            android:background="@drawable/rounded_white_bg"
            android:padding="8dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/secure_messages" />

        <!-- Pytanie -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Czy powinieneś kliknąć w ten link?"
            android:gravity="center"
            android:textSize="24sp"
            android:textStyle="bold"
            android:padding="24dp"
            android:background="#BFDBFE"
            android:layout_marginBottom="24dp" />

        <!-- Przyciski TAK / NIE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <Button
                android:id="@+id/yes_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TAK"
                android:background="#32CD32"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/no_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NIE"
                android:background="#FF0000"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Przyciski nawigacyjne -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/backButton"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:text="Wstecz" />

            <Button
                android:id="@+id/nextButton"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:text="Dalej" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
