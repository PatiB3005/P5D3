<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#BFDBFE">

    <!-- Toolbar na pełną szerokość -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#4F46E5"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title=""
        app:titleTextColor="@android:color/white" />

    <!-- Reszta treści w ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="32dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/titleMain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fake news i nagłówki"
                android:textColor="#0F172A"
                android:textSize="32sp"
                android:fontFamily="@font/montserrat_bold"
                android:layout_marginBottom="4dp"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/titleSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Moduł"
                android:textColor="#0F172A"
                android:textSize="26sp"
                android:fontFamily="@font/montserrat_bold"
                android:layout_marginBottom="36dp"
                android:textAlignment="center" />

            <!-- Kafelek: Quiz z nagłówkami -->
            <LinearLayout
                android:id="@+id/btnFakeNewsQuiz"
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:background="#93C5FD"
                android:gravity="center"
                android:elevation="8dp"
                android:clipToOutline="true"
                android:layout_marginBottom="28dp"
                android:padding="12dp"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginHorizontal="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quiz z nagłówkami"
                    android:textColor="#0F172A"
                    android:textSize="24sp"
                    android:fontFamily="@font/montserrat_bold"/>
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
