<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF2FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Tytuł sekcji -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CZĘŚĆ TESTOWA"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Nagłówek -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BEZPIECZNE WIADOMOŚCI"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <!-- Ikona srebrnego medalu -->
        <ImageView
            android:id="@+id/finishMedal"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/medal_silver"
            android:padding="20dp"
            android:layout_marginBottom="32dp" />

        <!-- Pole z gratulacjami -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GRATULACJE!\nUkończyłeś moduł\n„Bezpieczne wiadomości”\nz bardzo dobrym rezultatem!\n\nNaciśnij „Powrót do menu głównego”, aby kontynuować naukę w pozostałych modułach lub „Powtórz test”, żeby polepszyć wynik!"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="24dp"
            android:background="#BFDBFE"
            android:layout_marginBottom="32dp" />

        <!-- Dwa przyciski -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="2">

            <Button
                android:id="@+id/retryTestButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Powtórz test"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/backToMenuButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Powrót do menu głównego"
                android:layout_marginStart="12dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
