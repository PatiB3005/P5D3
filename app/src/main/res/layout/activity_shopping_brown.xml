<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5"
    tools:context=".ui.moduleMenu.modules.SmsEmailActivity">

    <!-- Scroll content -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingBottom="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="22dp"
            android:paddingBottom="12dp">

            <!-- Header (jedna linia) -->
            <TextView
                android:id="@+id/titleSafeMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ZAKUPY ONLINE"
                android:textColor="#1A202C"
                android:textSize="36sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:textAlignment="center"
                android:includeFontPadding="false"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="18dp" />

            <!-- MEDAL -->
            <ImageView
                android:id="@+id/finishMedal"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:src="@drawable/ic_medal_bronze"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:layout_marginBottom="16dp" />

            <!-- Karta tekstowa -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/congratsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#BFDBFE"
                app:strokeWidth="1dp"
                app:strokeColor="#A7C7F7"
                android:stateListAnimator="@null">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp">

                    <TextView
                        android:id="@+id/congratsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="GRATULACJE!"
                        android:textColor="#1A202C"
                        android:textSize="26sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:includeFontPadding="false"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/congratsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ukończyłeś moduł \n„Zakupy Online”.\n\nMożesz wrócić do menu głównego, aby kontynuować naukę, lub powtórzyć test, aby poprawić wynik!"
                        android:textColor="#1A202C"
                        android:textSize="20sp"
                        android:fontFamily="@font/montserrat_regular"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="5dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PRZYCISKI: jeden pod drugim -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/backToMenuButton"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:text="Powrót do menu głównego"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:textAlignment="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="20sp"
                android:autoSizeStepGranularity="1sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                app:cornerRadius="24dp"
                app:backgroundTint="#2B6CB0"
                app:rippleColor="#00000000"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryTestButton"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:text="Powtórz test"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:textAlignment="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="20sp"
                android:autoSizeStepGranularity="1sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                app:cornerRadius="24dp"
                app:backgroundTint="#2B6CB0"
                app:rippleColor="#00000000"
                android:elevation="0dp"
                android:stateListAnimator="@null" />

            <!-- mały dystans od dołu -->
            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
