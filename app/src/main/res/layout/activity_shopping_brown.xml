<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF2FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">


        <!-- Nagłówek modułu -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ZAKUPY ONLINE"
            android:gravity="center"
            android:textColor="#1E293B"
            android:textSize="38sp"
            android:textStyle="bold"
            android:fontFamily="@font/montserrat_bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"
            android:shadowColor="#55000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <!-- Medal -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_marginBottom="40dp"
            app:cardCornerRadius="32dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="#FFFFFF">

            <ImageView
                android:id="@+id/finishMedal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="24dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/medal_bronze"
                android:contentDescription="Srebrny medal za ukończenie modułu" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Gratulacje -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#DBEAFE">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GRATULACJE!\nUkończyłeś moduł „Zakupy Online”.\n\nMożesz wrócić do menu głównego, aby kontynuować naukę, lub powtórzyć test, aby poprawić wynik!"
                android:textSize="20sp"
                android:textColor="#1E293B"
                android:gravity="center"
                android:padding="28dp"
                android:lineSpacingExtra="4dp"
                android:fontFamily="@font/montserrat_regular"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Przyciski -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backToMenuButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Powrót do menu głównego"
                android:textSize="18sp"
                android:textAllCaps="false"
                android:fontFamily="@font/montserrat_bold"
                app:cornerRadius="16dp"
                app:backgroundTint="#2563EB"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryTestButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Powtórz test"
                android:textSize="18sp"
                android:textAllCaps="false"
                android:fontFamily="@font/montserrat_bold"
                app:cornerRadius="16dp"
                app:backgroundTint="#3F51B5"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
