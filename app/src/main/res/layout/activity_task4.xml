<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <!-- ZADANIE 4 -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Zadanie 4"
        android:textSize="44sp"
        android:textColor="#000"
        android:fontFamily="@font/montserrat_bold"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CO JEST PODEJRZANE? -->
    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Co jest podejrzane\nw tej wiadomości?"
        android:textSize="32sp"
        android:textColor="#000"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Opis -->
    <TextView
        android:id="@+id/description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Zobacz przykładowe wiadomości i sprawdź, co w nich może być oszustwem. Może być jedna albo dwie prawidłowe odpowiedzi."
        android:textSize="26sp"
        android:textColor="#000"
        android:fontFamily="@font/montserrat_regular"
        android:gravity="center"
        android:layout_marginTop="26dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- IKONA UWAGA (większa) -->
    <ImageView
        android:id="@+id/iconWarning"
        android:layout_width="320dp"
        android:layout_height="260dp"
        android:src="@drawable/ic_triangle"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- WSTECZ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        android:layout_width="180dp"
        android:layout_height="48dp"
        android:text="Wstecz"
        android:textSize="20sp"
        android:fontFamily="@font/montserrat_bold"
        android:textColor="#000"
        android:textAllCaps="false"
        android:gravity="center"
        app:cornerRadius="12dp"
        app:backgroundTint="#9D9FB0"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- ROZPOCZNIJ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStart"
        android:layout_width="180dp"
        android:layout_height="48dp"
        android:text="Rozpocznij"
        android:textSize="20sp"
        android:fontFamily="@font/montserrat_bold"
        android:textColor="#000"
        android:textAllCaps="false"
        android:gravity="center"
        app:cornerRadius="12dp"
        app:backgroundTint="#9D9FB0"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
