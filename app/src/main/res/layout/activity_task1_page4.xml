<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <!-- DUŻA KARTA (nagłówek) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginTop="50dp"
        app:cardBackgroundColor="#A5CCFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        android:stateListAnimator="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="30dp"
            android:paddingBottom="30dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Nie jesteś pewien, czy wiadomość jest prawdziwa."
            android:textColor="#1A202C"
            android:textSize="30sp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:fontFamily="@font/montserrat_bold" />
    </com.google.android.material.card.MaterialCardView>

    <!-- KARTA #1 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="30dp"
        app:cardBackgroundColor="#BFDBFE"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#A7C7F7"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/cardTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="Nie klikaj w linki z wiadomości."
            android:textSize="22sp"
            android:textColor="#1A202C"
            android:gravity="center"
            android:includeFontPadding="false"
            android:fontFamily="@font/montserrat_regular" />
    </com.google.android.material.card.MaterialCardView>

    <!-- KARTA #2 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#BFDBFE"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#A7C7F7"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/card1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="Zawsze sam oddzwoń na oficjalny numer."
            android:textSize="22sp"
            android:textColor="#1A202C"
            android:gravity="center"
            android:includeFontPadding="false"
            android:fontFamily="@font/montserrat_regular" />
    </com.google.android.material.card.MaterialCardView>

    <!-- KARTA #3 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#BFDBFE"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#A7C7F7"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/card2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="Nigdy nie podawaj kodów ani haseł."
            android:textSize="22sp"
            android:textColor="#1A202C"
            android:gravity="center"
            android:includeFontPadding="false"
            android:fontFamily="@font/montserrat_regular" />
    </com.google.android.material.card.MaterialCardView>

    <!-- KARTA #4 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#BFDBFE"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#A7C7F7"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/card3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="Zapytaj kogoś z rodziny lub zaufaną osobę."
            android:textSize="22sp"
            android:textColor="#1A202C"
            android:gravity="center"
            android:includeFontPadding="false"
            android:fontFamily="@font/montserrat_regular" />
    </com.google.android.material.card.MaterialCardView>

    <!-- PRZYCISK ZAKOŃCZ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFinish"
        android:layout_width="170dp"
        android:layout_height="56dp"
        android:text="Zakończ"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:fontFamily="@font/montserrat_bold"
        app:backgroundTint="#2B6CB0"
        android:alpha="0.45"
        android:enabled="false"
        android:clickable="false"
        app:cornerRadius="24dp"
        app:rippleColor="#00000000"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
