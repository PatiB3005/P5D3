<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EAF2FF">

    <!-- Górny pasek z napisem Ustawienia -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarSettings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#4F46E5"
        app:title="Ustawienia"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <!-- Zawartość ekranu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <Button
            android:id="@+id/btnFontSizeToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Powiększ tekst"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnTtsToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Włącz lektora"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>
