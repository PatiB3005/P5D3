<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF3FF">

    <!-- Nagłówek SCENARIUSZ -->
    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SCENARIUSZ"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ikona czapki -->
    <ImageView
        android:id="@+id/imgHat"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_mortarboard"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/textTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Pasek POUCZENIE -->
    <TextView
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="POUCZENIE"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:background="#C9E4FF"
        android:paddingHorizontal="24dp"
        android:paddingVertical="10dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/imgHat"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Blok z zasadami -->
    <TextView
        android:id="@+id/textInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#D8E8FF"
        android:padding="16dp"
        android:textSize="14sp"
        android:textColor="#000000"
        android:lineSpacingExtra="4dp"
        android:text="• Gdy ktoś podaje się za wnuka – rozłącz się i sam zadzwoń do rodziny na znany numer.\n\n• Nigdy nie wydawaj gotówki ani kosztowności obcej osobie „dla wnuka”.\n\n• Nie mów przez telefon, ile masz pieniędzy ani w jakim banku je trzymasz.\n\n• Nie podawaj PIN-ów, haseł ani kodów z SMS-ów.\n\n• O takim telefonie powiedz rodzinie lub zaufanemu sąsiadowi."
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Przycisk Zakończ -->
    <Button
        android:id="@+id/btnFinish"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:text="Zakończ"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:backgroundTint="#D80000"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/textInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
