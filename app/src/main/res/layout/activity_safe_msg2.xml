<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5"
    tools:context=".ui.moduleMenu.modules.SmsEmailActivity">


    <!-- Scroll content (NIE do dołu parenta, tylko do separatora nad przyciskami) -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="20dp"
            android:paddingBottom="18dp">

            <!-- Header subtitle -->
            <TextView
                android:id="@+id/headerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BEZPIECZNE WIADOMOŚCI"
                android:textColor="#1A202C"
                android:textSize="32sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:layout_marginTop="10dp" />

            <!-- Header title -->
            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Część teoretyczna"
                android:textColor="#4A5568"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp" />

            <!-- OBRAZEK -->
            <ImageView
                android:id="@+id/headerImage"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_safemsg2"
                android:contentDescription="@null"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:padding="4dp" />

            <!-- Blok 1 -->
            <TextView
                android:id="@+id/contentText1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/blue_box_radius"
                android:padding="18dp"
                android:textSize="22sp"
                android:lineSpacingExtra="7dp"
                android:textColor="#1A202C"
                android:fontFamily="@font/montserrat_regular"
                android:text="Oszustwa poprzez różnego rodzaju wiadomości to coraz częstszy sposób wyłudzania danych i pieniędzy. Przestępcy podszywają się pod banki, firmy kurierskie lub instytucje publiczne, wysyłając fałszywe SMS-y, e-maile lub wiadomości z linkami do podrobionych stron."
                android:layout_marginBottom="14dp" />

            <!-- Blok 2 -->
            <TextView
                android:id="@+id/contentText2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bluer_box_radius"
                android:padding="18dp"
                android:textSize="22sp"
                android:lineSpacingExtra="7dp"
                android:textColor="#1A202C"
                android:fontFamily="@font/montserrat_regular"
                android:text="- Fałszywa wygrana w konkursie\n- Prośba o dopłatę za paczkę\n- Wiadomości od rzekomego znajomego proszącego o pieniądze\nNauczmy się przed tym bronić!" />

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

        </LinearLayout>
    </ScrollView>

    <!-- separator nad przyciskami -->
    <View
        android:id="@+id/bottomDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#D9E2EF"
        app:layout_constraintBottom_toTopOf="@id/bottomButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Dolne przyciski -->
    <LinearLayout
        android:id="@+id/bottomButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:baselineAligned="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:layout_weight="1"
            android:text="Wstecz"
            android:textAllCaps="false"
            android:textSize="20sp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="22dp" />

        <Space
            android:layout_width="14dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:layout_weight="1"
            android:text="Dalej"
            android:textAllCaps="false"
            android:textSize="20sp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="22dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
