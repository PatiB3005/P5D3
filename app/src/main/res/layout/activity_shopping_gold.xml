<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="22dp"
            android:paddingBottom="24dp">

            <!-- Nagłówek modułu (treść bez zmian) -->
            <TextView
                android:id="@+id/titleModule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ZAKUPY ONLINE"
                android:gravity="center"
                android:textAlignment="center"
                android:includeFontPadding="false"
                android:textColor="#1A202C"
                android:textSize="36sp"
                android:fontFamily="@font/montserrat_bold"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="18dp" />

            <!-- Medal (treść/obraz bez zmian, tylko styl jak w nowym: bez białej karty) -->
            <ImageView
                android:id="@+id/finishMedal"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:src="@drawable/ic_medal_gold"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="Złoty medal za ukończenie modułu"
                android:layout_marginBottom="16dp" />

            <!-- Gratulacje (treść bez zmian, styl jak w nowym) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/congratsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#BFDBFE"
                app:strokeWidth="1dp"
                app:strokeColor="#A7C7F7"
                android:stateListAnimator="@null">

                <TextView
                    android:id="@+id/congratsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GRATULACJE!\nUkończyłeś moduł \n„Zakupy Online”\nz świetnym rezultatem!\n\nNaciśnij przycisk poniżej, aby wrócić do menu głównego."
                    android:textSize="20sp"
                    android:textColor="#1A202C"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:includeFontPadding="false"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:lineSpacingExtra="5dp"
                    android:fontFamily="@font/montserrat_regular"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Przycisk (treść bez zmian, styl jak w nowym) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/backToMenuButton"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:text="Powrót do menu głównego"
                android:textSize="20sp"
                android:textAllCaps="false"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#FFFFFF"
                app:cornerRadius="24dp"
                app:backgroundTint="#2B6CB0"
                app:rippleColor="#00000000"
                android:elevation="0dp"
                android:stateListAnimator="@null" />

            <View
                android:layout_width="match_parent"
                android:layout_height="6dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
