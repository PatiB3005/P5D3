<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#E9EEF5">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="80dp">

        <!-- Menu zadań -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTasksMenu"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Menu zadań"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#1A202C"
            android:backgroundTint="#DCEAFF"
            app:cornerRadius="14dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ===================== OBRAZ WIADOMOŚCI ===================== -->
        <ImageView
            android:id="@+id/imgMessage"
            android:layout_width="0dp"
            android:layout_height="300dp"
            android:src="@drawable/mbank"
            android:scaleType="fitCenter"
            android:layout_marginTop="90dp"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="36dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Hint: jedna odpowiedź -->
        <TextView
            android:id="@+id/hintAnswers"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Wybierz jedną odpowiedź."
            android:textSize="20sp"
            android:textColor="#4A5568"
            android:fontFamily="@font/montserrat_regular"
            android:gravity="center"
            android:layout_marginTop="18dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            app:layout_constraintTop_toBottomOf="@id/imgMessage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ===================== PRZYCISK 1 ===================== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnName"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:text="Nazwa banku"
            android:textSize="22sp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#1A202C"
            android:textAllCaps="false"
            android:backgroundTint="#DCEAFF"
            android:elevation="0dp"
            app:cornerRadius="30dp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            app:layout_constraintTop_toBottomOf="@id/hintAnswers"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ===================== PRZYCISK 2 ===================== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContent"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:text="Treść wiadomości"
            android:textSize="22sp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#1A202C"
            android:textAllCaps="false"
            android:backgroundTint="#DCEAFF"
            android:elevation="0dp"
            app:cornerRadius="30dp"
            android:layout_marginTop="36dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            app:layout_constraintTop_toBottomOf="@id/btnName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ===================== PRZYCISK 3 ===================== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLink"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:text="Link"
            android:textSize="22sp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#1A202C"
            android:textAllCaps="false"
            android:backgroundTint="#DCEAFF"
            android:elevation="0dp"
            app:cornerRadius="30dp"
            android:layout_marginTop="36dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            app:layout_constraintTop_toBottomOf="@id/btnContent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ===================== KOMENTARZ ===================== -->
        <TextView
            android:id="@+id/commentBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:textSize="18sp"
            android:textColor="#1A202C"
            android:gravity="center"
            android:background="#E9EEF5"
            android:visibility="gone"
            android:layout_marginTop="40dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            app:layout_constraintTop_toBottomOf="@id/btnLink"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ===================== DALEJ ===================== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="180dp"
            android:layout_height="58dp"
            android:text="Dalej"
            android:textSize="22sp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:backgroundTint="#2B6CB0"
            android:elevation="0dp"
            app:cornerRadius="24dp"
            android:visibility="gone"
            android:layout_marginTop="56dp"
            android:layout_marginEnd="40dp"
            app:layout_constraintTop_toBottomOf="@id/commentBox"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ===================== OVERLAY ===================== -->
        <View
            android:id="@+id/overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#88000000"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ===================== POPUP ===================== -->
        <LinearLayout
            android:id="@+id/popupBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:visibility="gone"
            android:gravity="center"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/popupText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#1A202C"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/popupClose"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:text="OK"
                android:textSize="18sp"
                android:fontFamily="@font/montserrat_bold"
                android:layout_marginTop="24dp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2B6CB0"
                app:cornerRadius="20dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
