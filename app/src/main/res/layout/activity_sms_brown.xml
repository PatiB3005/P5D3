<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF2FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">


        <!-- NAGŁÓWEK 1 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CZĘŚĆ TESTOWA"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/montserrat_bold"
            android:layout_marginBottom="12dp"/>

        <!-- NAGŁÓWEK 2 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BEZPIECZNE WIADOMOŚCI"
            android:textSize="23sp"
            android:textStyle="bold"
            android:fontFamily="@font/montserrat_bold"
            android:layout_marginBottom="24dp"/>


        <!-- OBRAZ MEDALU W KARCIE -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#000000"
            app:strokeWidth="2dp">

            <ImageView
                android:id="@+id/finishMedal"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:adjustViewBounds="true"
                android:padding="16dp"
                android:src="@drawable/medal_bronze"
                android:scaleType="fitCenter" />
        </com.google.android.material.card.MaterialCardView>


        <!-- KARTA Z TEKSTEM GRATULACJI -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#BFDBFE"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:text="GRATULACJE!\nUkończyłeś moduł „Bezpieczne wiadomości”.\n\nMożesz wrócić do menu głównego, aby kontynuować naukę, lub powtórzyć test, aby poprawić wynik!"
                android:textSize="20sp"
                android:gravity="center"
                android:textColor="#000"
                android:fontFamily="@font/montserrat_regular"/>
        </com.google.android.material.card.MaterialCardView>


        <!-- PRZYCISKI DOLNE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryTestButton"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                android:text="Powtórz test"
                android:textSize="20sp"
                android:textAllCaps="false"
                android:fontFamily="@font/montserrat_bold"
                app:cornerRadius="16dp"
                app:backgroundTint="#CBD5E1"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backToMenuButton"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                android:text="Menu główne"
                android:textSize="20sp"
                android:textAllCaps="false"
                android:fontFamily="@font/montserrat_bold"
                app:cornerRadius="16dp"
                app:backgroundTint="#9D9FB0"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

    </LinearLayout>

</ScrollView>
