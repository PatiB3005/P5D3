<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <!-- Scroll -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingEnd="26dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="22dp"
            android:paddingBottom="18dp">

            <!-- Tytuł główny -->
            <TextView
                android:id="@+id/headerMain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FAKE NEWS"
                android:textColor="#1A202C"
                android:textSize="32sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:layout_marginTop="8dp" />

            <!-- Podtytuł -->
            <TextView
                android:id="@+id/headerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYGNAŁY OSTRZEGAWCZE"
                android:textColor="#1A202C"
                android:textSize="28sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Część teoretyczna"
                android:textColor="#4A5568"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp" />

            <!-- OBRAZEK -->
            <ImageView
                android:id="@+id/headerImage"
                android:layout_width="250dp"
                android:layout_height="180dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_fake_news_5"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:padding="4dp"
                android:contentDescription="@null" />

            <!-- Blok 1 -->
            <TextView
                android:id="@+id/contentText1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/blue_box_radius"
                android:padding="18dp"
                android:textSize="22sp"
                android:lineSpacingExtra="7dp"
                android:textColor="#1A202C"
                android:fontFamily="@font/montserrat_regular"
                android:text="Uważaj na wiadomości, które mocno straszą albo oburzają i każą działać szybko. Podejrzane są nagłówki o „wielkich zmianach dla wszystkich” bez jasnych szczegółów i bez źródła. Niepokojące są też teksty z błędami, krzykliwymi słowami i bez informacji: kto, gdzie i kiedy to ogłosił."
                android:layout_marginBottom="14dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />
        </LinearLayout>
    </ScrollView>

    <!-- TRACK (szary tor po prawej) -->
    <View
        android:id="@+id/customScrollTrack"
        android:layout_width="6dp"
        android:layout_height="0dp"
        android:layout_marginEnd="12dp"
        android:background="#D9E2EF"
        app:layout_constraintTop_toTopOf="@id/scrollContent"
        app:layout_constraintBottom_toBottomOf="@id/scrollContent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- THUMB (niebieski suwak) -->
    <View
        android:id="@+id/customScrollThumb"
        android:layout_width="6dp"
        android:layout_height="54dp"
        android:layout_marginEnd="12dp"
        android:background="#2B6CB0"
        app:layout_constraintTop_toTopOf="@id/customScrollTrack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0" />

    <!-- separator -->
    <View
        android:id="@+id/bottomDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#D9E2EF"
        app:layout_constraintBottom_toTopOf="@id/bottomButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom buttons -->
    <LinearLayout
        android:id="@+id/bottomButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:baselineAligned="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:layout_weight="1"
            android:text="Wstecz"
            android:textAllCaps="false"
            android:textSize="20sp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="22dp" />

        <Space
            android:layout_width="14dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:layout_weight="1"
            android:text="Dalej"
            android:textAllCaps="false"
            android:textSize="20sp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="22dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
