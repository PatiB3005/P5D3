<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <!-- Scroll (nie nachodzi na przycisk) -->
    <ScrollView
        android:id="@+id/scrollArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- Tytuł -->
            <TextView
                android:id="@+id/quizTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUIZ – pytania 3 i 4"
                android:textColor="#1A202C"
                android:textSize="30sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:layout_marginBottom="18dp" />

            <!-- BLOK: Pytanie 3 + odpowiedzi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/blue_box_radius"
                android:padding="18dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="22dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/question3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. Co NAJLEPIEJ wskazuje, że opis produktu może być fałszywy?"
                    android:textSize="22sp"
                    android:fontFamily="@font/montserrat_regular"
                    android:textColor="#1A202C"
                    android:layout_marginBottom="12dp" />

                <!-- ŁADNE ODPOWIEDZI (kafelki) -->
                <RadioGroup
                    android:id="@+id/groupQ3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/q3_a"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Opis jest bardzo krótki"
                        android:textSize="20sp"
                        android:fontFamily="@font/montserrat_regular"
                        android:textColor="#1A202C"
                        android:button="@null"
                        android:background="@drawable/radio_option_bg"
                        android:padding="14dp"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:lineSpacingExtra="2dp" />

                    <RadioButton
                        android:id="@+id/q3_b"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Opis jest pełen ogólników typu „najlepsza okazja”"
                        android:textSize="20sp"
                        android:fontFamily="@font/montserrat_regular"
                        android:textColor="#1A202C"
                        android:button="@null"
                        android:background="@drawable/radio_option_bg"
                        android:padding="14dp"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginTop="10dp" />

                    <RadioButton
                        android:id="@+id/q3_c"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Opis ma pojedyncze literówki"
                        android:textSize="20sp"
                        android:fontFamily="@font/montserrat_regular"
                        android:textColor="#1A202C"
                        android:button="@null"
                        android:background="@drawable/radio_option_bg"
                        android:padding="14dp"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginTop="10dp" />

                </RadioGroup>

                <TextView
                    android:id="@+id/feedbackQ3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="19sp"
                    android:fontFamily="@font/montserrat_regular"
                    android:textColor="#1A202C"
                    android:visibility="gone"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- BLOK: Pytanie 4 + odpowiedzi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/blue_box_radius"
                android:padding="18dp"
                android:layout_marginBottom="6dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/question4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4. Co najbardziej obniża wiarygodność sklepu z reklamy?"
                    android:textSize="22sp"
                    android:fontFamily="@font/montserrat_regular"
                    android:textColor="#1A202C"
                    android:layout_marginBottom="12dp" />

                <!-- ŁADNE ODPOWIEDZI (kafelki) -->
                <RadioGroup
                    android:id="@+id/groupQ4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/q4_a"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reklama jest udostępniana w nieznanym źródle"
                        android:textSize="20sp"
                        android:fontFamily="@font/montserrat_regular"
                        android:textColor="#1A202C"
                        android:button="@null"
                        android:background="@drawable/radio_option_bg"
                        android:padding="14dp"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:lineSpacingExtra="2dp" />

                    <RadioButton
                        android:id="@+id/q4_b"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reklama jest niechlujna lub wygląda amatorsko"
                        android:textSize="20sp"
                        android:fontFamily="@font/montserrat_regular"
                        android:textColor="#1A202C"
                        android:button="@null"
                        android:background="@drawable/radio_option_bg"
                        android:padding="14dp"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginTop="10dp" />

                    <RadioButton
                        android:id="@+id/q4_c"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reklama pokazuje tylko produkt bez opisów"
                        android:textSize="20sp"
                        android:fontFamily="@font/montserrat_regular"
                        android:textColor="#1A202C"
                        android:button="@null"
                        android:background="@drawable/radio_option_bg"
                        android:padding="14dp"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginTop="10dp" />

                </RadioGroup>

                <TextView
                    android:id="@+id/feedbackQ4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="19sp"
                    android:fontFamily="@font/montserrat_regular"
                    android:textColor="#1A202C"
                    android:visibility="gone"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

        </LinearLayout>
    </ScrollView>

    <!-- separator -->
    <View
        android:id="@+id/bottomDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#D9E2EF"
        app:layout_constraintBottom_toTopOf="@id/bottomButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- PRZYCISK DALEJ -->
    <LinearLayout
        android:id="@+id/bottomButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="Dalej"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:fontFamily="@font/montserrat_bold"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="20dp"
            android:enabled="false" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
