<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <ScrollView
        android:id="@+id/scrollArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- Tytuł -->
            <TextView
                android:id="@+id/quizTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUIZ – pytania 3 i 4"
                android:textColor="#1A202C"
                android:textSize="30sp"
                android:fontFamily="@font/montserrat_bold"
                android:layout_marginBottom="32dp"
                android:gravity="center"/>

            <!-- Obrazek -->
            <ImageView
                android:id="@+id/quizImage"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:src="@drawable/ic_quiz_shopping_2"
                android:layout_marginBottom="32dp"/>

            <!-- PYTANIE 3 -->
            <TextView
                android:id="@+id/question3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Co NAJLEPIEJ wskazuje, że opis produktu może być fałszywy?"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#1A202C"
                android:layout_marginBottom="12dp"/>

            <RadioGroup
                android:id="@+id/groupQ3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/q3_a"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="opis jest bardzo krótki"
                    android:textSize="20sp"
                    android:fontFamily="@font/montserrat_regular"/>

                <RadioButton
                    android:id="@+id/q3_b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="opis jest pełen ogólników typu „najlepsza okazja”"
                    android:textSize="20sp"
                    android:fontFamily="@font/montserrat_regular"/>

                <RadioButton
                    android:id="@+id/q3_c"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="opis ma pojedyncze literówki"
                    android:textSize="20sp"
                    android:fontFamily="@font/montserrat_regular"/>
            </RadioGroup>

            <TextView
                android:id="@+id/feedbackQ3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="19sp"
                android:fontFamily="@font/montserrat_regular"
                android:textColor="#1A202C"
                android:visibility="gone"
                android:layout_marginBottom="24dp"/>

            <!-- PYTANIE 4 -->
            <TextView
                android:id="@+id/question4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Co najbardziej obniża wiarygodność sklepu z reklamy?"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#1A202C"
                android:layout_marginBottom="12dp"/>

            <RadioGroup
                android:id="@+id/groupQ4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/q4_a"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="reklama jest udostępniana w nieznanym źródle"
                    android:textSize="20sp"
                    android:fontFamily="@font/montserrat_regular"/>

                <RadioButton
                    android:id="@+id/q4_b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="reklama jest niechlujna lub wygląda amatorsko"
                    android:textSize="20sp"
                    android:fontFamily="@font/montserrat_regular"/>

                <RadioButton
                    android:id="@+id/q4_c"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="reklama pokazuje tylko produkt bez opisów"
                    android:textSize="20sp"
                    android:fontFamily="@font/montserrat_regular"/>
            </RadioGroup>

            <TextView
                android:id="@+id/feedbackQ4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="19sp"
                android:fontFamily="@font/montserrat_regular"
                android:textColor="#1A202C"
                android:visibility="gone"
                android:layout_marginBottom="24dp"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="Dalej"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:fontFamily="@font/montserrat_bold"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="20dp"
            android:enabled="false"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
