<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#E9EEF5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="18dp"
        android:paddingBottom="28dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- OBRAZEK w białym, zaokrąglonym kafelku -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/headerCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="22dp"
            app:cardElevation="6dp"
            app:contentPadding="10dp">

            <ImageView
                android:id="@+id/headerImage"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:src="@drawable/ic_mortarboard"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="@null" />
        </com.google.android.material.card.MaterialCardView>

        <!-- TYTUŁ (wyżej + mniejsza przerwa) -->
        <TextView
            android:id="@+id/textTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POUCZENIE"
            android:textSize="34sp"
            android:textColor="#000000"
            android:fontFamily="@font/montserrat_bold"
            android:layout_marginBottom="18dp" />

        <!-- ITEM 1 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#D9E2EF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#E7F0FF">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="✓"
                        android:textSize="22sp"
                        android:textColor="#2B6CB0"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Bank nigdy nie prosi o podanie kodów z SMS-ów przez telefon."
                    android:textSize="18sp"
                    android:textColor="#1A202C"
                    android:lineSpacingExtra="6dp"
                    android:fontFamily="@font/montserrat_regular" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ITEM 2 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#D9E2EF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#E7F0FF">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="✓"
                        android:textSize="22sp"
                        android:textColor="#2B6CB0"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Bank nigdy nie każe przelewać pieniędzy na „konto techniczne”."
                    android:textSize="18sp"
                    android:textColor="#1A202C"
                    android:lineSpacingExtra="6dp"
                    android:fontFamily="@font/montserrat_regular" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ITEM 3 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#D9E2EF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#E7F0FF">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="✓"
                        android:textSize="22sp"
                        android:textColor="#2B6CB0"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Jeśli telefon wydaje Ci się podejrzany, rozłącz się i zadzwoń samodzielnie na oficjalną infolinię banku."
                    android:textSize="18sp"
                    android:textColor="#1A202C"
                    android:lineSpacingExtra="6dp"
                    android:fontFamily="@font/montserrat_regular" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ITEM 4 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#D9E2EF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#E7F0FF">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="✓"
                        android:textSize="22sp"
                        android:textColor="#2B6CB0"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Nie ufaj numerowi wyświetlanemu na ekranie – oszuści mogą się pod niego podszywać."
                    android:textSize="18sp"
                    android:textColor="#1A202C"
                    android:lineSpacingExtra="6dp"
                    android:fontFamily="@font/montserrat_regular" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ITEM 5 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#D9E2EF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#E7F0FF">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="✓"
                        android:textSize="22sp"
                        android:textColor="#2B6CB0"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Porozmawiaj z rodziną i ostrzeż innych przed takimi telefonami."
                    android:textSize="18sp"
                    android:textColor="#1A202C"
                    android:lineSpacingExtra="6dp"
                    android:fontFamily="@font/montserrat_regular" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PRZYCISK (wyśrodkowany + równo) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinish"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_marginTop="10dp"
            android:text="Zakończ"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="24dp" />

    </LinearLayout>

</ScrollView>
