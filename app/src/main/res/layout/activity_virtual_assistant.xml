<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#2563EB"
        app:navigationIcon="@drawable/ic_arrow_back_black"
        app:title=""
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wirtualny\nAsystent"
                android:textAlignment="center"
                android:fontFamily="@font/montserrat_bold"
                android:textStyle="bold"
                android:textSize="36sp"
                android:textColor="#000000"
                android:gravity="center"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Napisz dręczące cię pytanie, a\nasystent przeszuka bazę wiedzy\nżeby ci pomóc."
                android:textSize="18sp"
                android:fontFamily="@font/montserrat_regular"
                android:textAlignment="center"
                android:gravity="center"
                android:textColor="#1A202C"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/questionInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Napisz swoje pytanie..."
                android:minLines="1"
                android:maxLines="6"
                android:gravity="top|start"
                android:fontFamily="@font/montserrat_regular"
                android:background="@drawable/edittext_bg"
                android:padding="12dp"
                android:layout_marginTop="24dp" />

            <Button
                android:id="@+id/btnAsk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zapytaj"
                android:textSize="18sp"
                android:background="@drawable/button_blue"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="16dp"
                android:paddingLeft="28dp"
                android:paddingRight="28dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/answerLabel"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Odpowiedź"
                android:textSize="18sp"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/montserrat_regular"
                android:textColor="#1A202C"/>

            <TextView
                android:id="@+id/answerArea"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edittext_bg"
                android:text=""
                android:padding="12dp"
                android:textSize="16sp"
                android:fontFamily="@font/montserrat_regular"
                android:textColor="#000000"
                android:layout_marginTop="12dp"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
