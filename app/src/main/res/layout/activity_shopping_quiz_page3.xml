<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <ScrollView
        android:id="@+id/scrollArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- Tytuł -->
            <TextView
                android:id="@+id/quizTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUIZ – pytania 5 i 6"
                android:textColor="#1A202C"
                android:textSize="30sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:layout_marginBottom="32dp"/>

            <!-- Obrazek -->
            <ImageView
                android:id="@+id/quizImage"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:src="@drawable/ic_quiz_shopping_page3"
                android:layout_marginBottom="32dp"/>


            <!-- PYTANIE 5 -->
            <TextView
                android:id="@+id/question5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. Które zachowanie może świadczyć o fałszywym sklepie internetowym?"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_bold"
                android:layout_marginBottom="12dp"
                android:textColor="#1A202C"/>

            <RadioGroup
                android:id="@+id/groupQ5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/q5_a"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Regulamin ma kilka drobnych literówek"
                    android:textSize="20sp"
                    android:fontFamily="@font/montserrat_regular"/>

                <RadioButton
                    android:id="@+id/q5_b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sklep nie oferuje płatności przy odbiorze"
                    android:textSize="20sp"
                    android:fontFamily="@font/montserrat_regular"/>

                <RadioButton
                    android:id="@+id/q5_c"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Strona działa w HTTPS i prosi o akceptację plików cookies"
                    android:textSize="20sp"
                    android:fontFamily="@font/montserrat_regular"/>
            </RadioGroup>

            <TextView
                android:id="@+id/feedbackQ5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="19sp"
                android:fontFamily="@font/montserrat_regular"
                android:textColor="#1A202C"
                android:visibility="gone"
                android:layout_marginBottom="24dp"/>


            <!-- PYTANIE 6 -->
            <TextView
                android:id="@+id/question6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="6. Co jest najmniej podejrzane przy zdjęciach produktów?"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#1A202C"
                android:layout_marginBottom="12dp"/>

            <RadioGroup
                android:id="@+id/groupQ6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/q6_a"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Zdjęcia są lekko rozmazane — wyglądają na zrobione telefonem"
                    android:textSize="20sp"
                    android:fontFamily="@font/montserrat_regular"/>

                <RadioButton
                    android:id="@+id/q6_b"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Zdjęcia są idealne i wyglądają jak z banku zdjęć"
                    android:textSize="20sp"
                    android:fontFamily="@font/montserrat_regular"/>

                <RadioButton
                    android:id="@+id/q6_c"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Produkt pokazano tylko na jednym zdjęciu i w jednym ujęciu"
                    android:textSize="20sp"
                    android:fontFamily="@font/montserrat_regular"/>
            </RadioGroup>

            <TextView
                android:id="@+id/feedbackQ6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="19sp"
                android:fontFamily="@font/montserrat_regular"
                android:textColor="#1A202C"
                android:visibility="gone"
                android:layout_marginBottom="24dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Przyciski -->
    <LinearLayout
        android:id="@+id/bottomButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="Dalej"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:fontFamily="@font/montserrat_bold"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="20dp"
            android:enabled="false"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
