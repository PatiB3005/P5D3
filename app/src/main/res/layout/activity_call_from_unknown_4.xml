<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="56dp" />

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topGuide"
        app:layout_constraintBottom_toTopOf="@id/bottomDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="22dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/headerMain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TELEFON OD PODEJRZANEGO NIEZNAJOMEGO"
                android:textColor="#1A202C"
                android:textSize="32sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/headerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JAKICH DANYCH NIE PODAWAĆ?"
                android:textColor="#1A202C"
                android:textSize="28sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:text="Część teoretyczna"
                android:textColor="#4A5568"
                android:textSize="22sp" />

            <ImageView
                android:id="@+id/headerImage"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_call_from_unknown4"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:padding="4dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/contentText1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/blue_box_radius"
                android:padding="18dp"
                android:textSize="22sp"
                android:lineSpacingExtra="7dp"
                android:textColor="#1A202C"
                android:fontFamily="@font/montserrat_regular"
                android:text="Wiedząc już jaki mają cel oszuści - możemy im to uniemożliwić niepodając informacji których potrzebują."
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/contentText2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bluer_box_radius"
                android:padding="18dp"
                android:textSize="22sp"
                android:lineSpacingExtra="7dp"
                android:textColor="#1A202C"
                android:fontFamily="@font/montserrat_regular"
                android:text="Nigdy nie udostępniaj:\n\n- Danych osobowych: PESEL, numer dowodu, adres, datę urodzenia.\n- Danych finansowych: numer konta, numer karty, PIN, hasła do bankowości online.\n- Kodów SMS lub BLIK.\n- Informacji o tym, kto mieszka w domu lub o Twoich codziennych planach."
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/contentText3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/blue_box_radius"
                android:padding="18dp"
                android:textSize="22sp"
                android:lineSpacingExtra="7dp"
                android:textColor="#1A202C"
                android:fontFamily="@font/montserrat_regular"
                android:text="Znając te granice, chronisz siebie i swoje pieniądze, bo oszuści często próbują wykorzystać nawet pozornie nieistotne informacje." />

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/bottomDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#D9E2EF"
        app:layout_constraintBottom_toTopOf="@id/bottomButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/bottomButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:baselineAligned="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:layout_weight="1"
            android:text="Wstecz"
            android:textAllCaps="false"
            android:textSize="20sp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="22dp" />

        <Space
            android:layout_width="14dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:layout_weight="1"
            android:text="Dalej"
            android:textAllCaps="false"
            android:textSize="20sp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="22dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
