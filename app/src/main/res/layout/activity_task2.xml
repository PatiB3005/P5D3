<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <!-- Zadanie 2 -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Zadanie 2"
        android:textSize="44sp"
        android:textColor="#000"
        android:fontFamily="@font/montserrat_bold"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Dopasuj zasadę -->
    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Prawda czy Fałsz"
        android:textSize="36sp"
        android:textColor="#000"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Tekst główny (wyśrodkowany i wyżej) -->
    <TextView
        android:id="@+id/description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Przeczytaj zdania i\nzdecyduj, czy są prawdziwe, czy fałszywe.
Kliknij „Prawda” lub „Fałsz”,\nżeby sprawdzić swoją odpowiedź!"
        android:textSize="28sp"
        android:textColor="#000"
        android:fontFamily="@font/montserrat_regular"
        android:gravity="center"
        android:layout_marginTop="26dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- KOPERTA – BEZ ZMIAN -->
    <ImageView
        android:id="@+id/iconEnvelope"
        android:layout_width="260dp"
        android:layout_height="200dp"
        android:src="@drawable/ic_true_false"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- WSTECZ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        android:layout_width="180dp"
        android:layout_height="48dp"
        android:text="Wstecz"
        android:textSize="20sp"
        android:fontFamily="@font/montserrat_bold"
        android:textColor="#000"
        android:textAllCaps="false"
        android:gravity="center"
        app:cornerRadius="12dp"
        app:backgroundTint="#9D9FB0"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- ROZPOCZNIJ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStart"
        android:layout_width="180dp"
        android:layout_height="48dp"
        android:text="Rozpocznij"
        android:textSize="20sp"
        android:fontFamily="@font/montserrat_bold"
        android:textColor="#000"
        android:textAllCaps="false"
        android:gravity="center"
        app:cornerRadius="12dp"
        app:backgroundTint="#9D9FB0"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
