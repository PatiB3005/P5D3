<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F0FA"
    tools:context=".ui.moduleMenu.modules.aiLite.AiActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#4F46E5"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:titleTextColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <TextView
                android:id="@+id/moduleTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Lite"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:fontFamily="@font/montserrat_bold"
                android:layout_marginBottom="28dp" />

            <!-- KAFEL 1: TEORIA -->
            <LinearLayout
                android:id="@+id/btnAiTeoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/module_card"
                android:padding="20dp"
                android:layout_marginBottom="22dp"
                android:layout_marginHorizontal="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_ai_theory_banner"
                    android:background="@drawable/rounded_image"
                    android:clipToOutline="true"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teoria"
                    android:fontFamily="@font/montserrat_bold"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dowiedz się, czym jest AI, jak działa w praktyce i na co uważać, gdy korzystasz z narzędzi generatywnych."
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/montserrat_regular"
                    android:textSize="16sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- KAFEL 2: ROZPOZNAJ ZDJĘCIA -->
            <LinearLayout
                android:id="@+id/btnAiPhoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/module_card"
                android:padding="20dp"
                android:layout_marginHorizontal="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_ai_photo_banner"
                    android:background="@drawable/rounded_image"
                    android:clipToOutline="true"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rozpoznaj zdjęcia"
                    android:fontFamily="@font/montserrat_bold"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sprawdź, czy potrafisz wykryć obraz wygenerowany przez AI: artefakty, nienaturalne detale i brak spójności."
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/montserrat_regular"
                    android:textSize="16sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
