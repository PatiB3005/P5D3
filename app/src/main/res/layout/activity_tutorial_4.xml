<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <ImageButton
        android:id="@+id/btnBackToMain"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_arrow_back_black"
        android:contentDescription="Wróć do menu głównego"
        android:scaleType="centerInside"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.02"/>

            <TextView
                android:id="@+id/text_tytul"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dodatkowe\nfunkcje"
                android:textColor="#1A202C"
                android:textSize="36sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:textAlignment="center"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/text_opis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Smart Senior to nie tylko nauka. Aplikacja przypomni Ci o lekach, zapisze Twoje postępy i pomoże w codziennych zadaniach."
                android:textColor="#4A5568"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:textAlignment="center"
                android:lineSpacingExtra="6dp"
                android:layout_marginBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="14dp">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="124dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/blue_box_radius"
                    android:padding="18dp">

                    <ImageView
                        android:id="@+id/icon_person"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_person"
                        android:alpha="0.95"
                        app:tint="#2B6CB0"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null"/>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="124dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/blue_box_radius"
                    android:padding="18dp">

                    <ImageView
                        android:id="@+id/icon_medicine"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_medicine"
                        android:alpha="0.95"
                        app:tint="#2B6CB0"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null"/>
                </FrameLayout>

            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/blue_box_radius"
                android:padding="12dp"
                android:layout_marginBottom="6dp">

                <ImageView
                    android:id="@+id/icon_progress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_progress"
                    android:alpha="0.95"
                    app:tint="#2B6CB0"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null"/>
            </FrameLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.04"/>

        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/separator"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#D9E2EF"
        app:layout_constraintBottom_toTopOf="@id/bottomContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_dalej"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="Dalej ➜"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="20dp"
            app:strokeWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
