<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <!-- Tytuł -->
    <TextView
        android:id="@+id/textTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="AI Lite"
        android:textSize="42sp"
        android:textColor="#1A202C"
        android:gravity="center"
        android:fontFamily="@font/montserrat_bold"
        android:layout_marginTop="40dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Podtytuł -->
    <TextView
        android:id="@+id/textSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Wprowadzenie do AI Lite"
        android:textSize="26sp"
        android:textColor="#4A5568"
        android:gravity="center"
        android:fontFamily="@font/montserrat_bold"
        android:layout_marginTop="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/textTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Obrazek -->
    <ImageView
        android:id="@+id/theoryImage"
        android:layout_width="260dp"
        android:layout_height="200dp"
        android:src="@drawable/apa"
        android:layout_marginTop="30dp"
        android:contentDescription="Obraz teorii"
        app:layout_constraintTop_toBottomOf="@id/textSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Treść -->
    <TextView
        android:id="@+id/textContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="W internecie pojawia się coraz więcej zdjęć wygenerowanych przez sztuczną inteligencje.\n\n. Czym są takie zdjęcia i z czym się one wiązą?\nDowiesz się tego w tym module!"
        android:textSize="22sp"
        android:textColor="#1A202C"
        android:lineSpacingExtra="6dp"
        android:gravity="center"
        android:fontFamily="@font/montserrat_regular"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/theoryImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Przycisk Dalej -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Dalej"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/montserrat_bold"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="40dp"
        app:backgroundTint="#2B6CB0"
        app:cornerRadius="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
