<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- mniejszy luz u góry -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.05"/>

            <TextView
                android:id="@+id/text_tytul"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nauka przez\nzabawę"
                android:textColor="#1A202C"
                android:textSize="36sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:textAlignment="center"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/text_opis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Poznaj przydatne funkcje telefonu w prosty i przyjemny sposób."
                android:textColor="#4A5568"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:textAlignment="center"
                android:lineSpacingExtra="6dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/text_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Każda lekcja to krótki krok. Na końcu sprawdzisz się w prostych zadaniach."
                android:textColor="#4A5568"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:textAlignment="center"
                android:lineSpacingExtra="6dp"
                android:layout_marginBottom="12dp"/>

            <ImageView
                android:id="@+id/img_hat"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:alpha="0.9"
                android:contentDescription="@null"
                android:src="@drawable/ic_hat1"
                app:tint="#2B6CB0"
                android:layout_marginBottom="4dp"/>

            <!-- mały luz na dole -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.08"/>

        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/separator"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#D9E2EF"
        app:layout_constraintBottom_toTopOf="@id/bottomContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_dalej"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="Dalej ➜"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="20dp"
            app:strokeWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
