<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- Avatar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/avatarCircle"
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:cardCornerRadius="36dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#E9EEF5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvInitials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:text="A"
                android:textColor="#1A202C"
                android:textSize="26sp" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Menu ⋮ -->
    <TextView
        android:id="@+id/tvMenu"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:text="⋮"
        android:textSize="30sp"
        android:textColor="#4A5568"
        android:gravity="center"
        android:fontFamily="@font/montserrat_bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Nazwa (obok avatara) -->
    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:text="Imię i nazwisko bardzo długie bardzo długie"
        android:textSize="24sp"
        android:textColor="#1A202C"
        android:fontFamily="@font/montserrat_bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toEndOf="@id/avatarCircle"
        app:layout_constraintEnd_toStartOf="@id/tvMenu"
        app:layout_constraintTop_toTopOf="@id/avatarCircle" />

    <!-- Chip POD nazwą -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/chipWrap"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#BEE3F8"
        app:layout_constraintStart_toEndOf="@id/avatarCircle"
        app:layout_constraintTop_toBottomOf="@id/tvName">

        <TextView
            android:id="@+id/tvChip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Zaufany"
            android:textSize="16sp"
            android:textColor="#2B6CB0"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Numer telefonu (pod avatarem / chipem) -->
    <TextView
        android:id="@+id/tvPhone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="697 242 875"
        android:textSize="22sp"
        android:textColor="#1A202C"
        android:fontFamily="@font/montserrat_regular"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        app:layout_constrainedWidth="true"
        app:layout_constraintTop_toBottomOf="@id/avatarCircle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Duży przycisk NA DOLE (pełna szerokość) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCall"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginTop="16dp"
        android:text="Zadzwoń"
        android:textAllCaps="false"
        android:textSize="24sp"
        android:fontFamily="@font/montserrat_bold"
        android:textColor="#FFFFFF"
        app:backgroundTint="#2B6CB0"
        app:cornerRadius="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvPhone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Divider -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#E9EEF5"
        app:layout_constraintTop_toBottomOf="@id/btnCall"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
