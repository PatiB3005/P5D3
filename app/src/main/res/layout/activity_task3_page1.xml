<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- PARA 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="72dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn1Left"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#DCEAFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                android:stateListAnimator="@null"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/btn1Left_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="mBank"
                        android:textSize="24sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="#1A202C"
                        android:includeFontPadding="false"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/btn1Left_domain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=".pl"
                        android:textSize="24sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="#1A202C"
                        android:includeFontPadding="false"
                        android:gravity="center"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn1Right"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#DCEAFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                android:stateListAnimator="@null"
                android:layout_marginStart="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/btn1Right_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="rnBank"
                        android:textSize="24sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="#1A202C"
                        android:includeFontPadding="false"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/btn1Right_domain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=".pl"
                        android:textSize="24sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="#1A202C"
                        android:includeFontPadding="false"
                        android:gravity="center"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <TextView
            android:id="@+id/comment1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Komentarz: rn to nie m — fałszywa nazwa."
            android:textColor="#1A202C"
            android:textSize="22sp"
            android:fontFamily="@font/montserrat_regular"
            android:includeFontPadding="false"
            android:gravity="center"
            android:background="#E9EEF5"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="72dp"
            android:lineSpacingExtra="4dp"
            android:visibility="gone"/>


        <!-- === PARA 2 === -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="72dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn2Left"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="#DCEAFF"
                app:cardElevation="0dp"
                android:stateListAnimator="@null"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="allegro"
                        android:textSize="24sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="#1A202C"
                        android:includeFontPadding="false"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=".pl"
                        android:textSize="24sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="#1A202C"
                        android:includeFontPadding="false"
                        android:gravity="center"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn2Right"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="#DCEAFF"
                app:cardElevation="0dp"
                android:stateListAnimator="@null"
                android:layout_marginStart="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="allegro-win"
                        android:textSize="24sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="#1A202C"
                        android:includeFontPadding="false"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=".com"
                        android:textSize="24sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="#1A202C"
                        android:includeFontPadding="false"
                        android:gravity="center"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <TextView
            android:id="@+id/comment2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Komentarz: Dodatkowe słowa w adresie to częsty trik oszustów."
            android:textColor="#1A202C"
            android:textSize="22sp"
            android:fontFamily="@font/montserrat_regular"
            android:includeFontPadding="false"
            android:gravity="center"
            android:background="#E9EEF5"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="72dp"
            android:lineSpacingExtra="4dp"
            android:visibility="gone"/>


        <!-- === PARA 3 === -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="72dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn3Left"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="#DCEAFF"
                app:cardElevation="0dp"
                android:stateListAnimator="@null"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:text="inpost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="#1A202C"
                        android:includeFontPadding="false"/>

                    <TextView
                        android:text=".pl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="#1A202C"
                        android:includeFontPadding="false"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn3Right"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="#DCEAFF"
                app:cardElevation="0dp"
                android:stateListAnimator="@null"
                android:layout_marginStart="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:text="inpost24"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="#1A202C"
                        android:includeFontPadding="false"/>

                    <TextView
                        android:text=".info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="#1A202C"
                        android:includeFontPadding="false"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <TextView
            android:id="@+id/comment3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Komentarz: Prawdziwe firmy mają końcówkę .pl lub .com."
            android:textColor="#1A202C"
            android:textSize="22sp"
            android:fontFamily="@font/montserrat_regular"
            android:includeFontPadding="false"
            android:gravity="center"
            android:background="#E9EEF5"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="72dp"
            android:lineSpacingExtra="4dp"
            android:visibility="gone"/>


        <!-- === PARA 4 === -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="72dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn4Left"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="#DCEAFF"
                app:cardElevation="0dp"
                android:stateListAnimator="@null">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/btn4Left_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" poczta-\npolska"
                        android:textSize="24sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="#1A202C"
                        android:includeFontPadding="false"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/btn4Left_domain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=".pl"
                        android:textSize="24sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="#1A202C"
                        android:includeFontPadding="false"
                        android:gravity="center"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn4Right"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="#DCEAFF"
                app:cardElevation="0dp"
                android:stateListAnimator="@null">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/btn4Right_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="poczta-\npolska24"
                        android:textSize="24sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="#1A202C"
                        android:includeFontPadding="false"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/btn4Right_domain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=".com"
                        android:textSize="24sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="#1A202C"
                        android:includeFontPadding="false"
                        android:gravity="center"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <TextView
            android:id="@+id/comment4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Komentarz: Fałszywe strony Poczty Polskiej to częste oszustwo."
            android:textColor="#1A202C"
            android:textSize="22sp"
            android:fontFamily="@font/montserrat_regular"
            android:includeFontPadding="false"
            android:gravity="center"
            android:background="#E9EEF5"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="72dp"
            android:lineSpacingExtra="4dp"
            android:visibility="gone"/>


        <!-- PRZYCISK DALEJ (styl jak w wzorcu) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="200dp"
            android:layout_height="70dp"
            android:text="Dalej"
            android:textSize="22sp"
            android:fontFamily="@font/montserrat_bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:cornerRadius="24dp"
            android:backgroundTint="#2B6CB0"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            app:rippleColor="#00000000"
            android:visibility="gone"
            android:enabled="false"
            android:layout_gravity="center"/>


    </LinearLayout>
</ScrollView>
