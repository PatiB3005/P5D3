<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF2FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Tytuł sekcji -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CZĘŚĆ TESTOWA"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginBottom="8dp" />

        <!-- Nagłówek -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BEZPIECZNE WIADOMOŚCI"
            android:textStyle="bold"
            android:textSize="26sp"
            android:layout_marginBottom="24dp" />

        <!-- Ikona medalu -->
        <ImageView
            android:id="@+id/finishMedal"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/medal_gold"
            android:layout_marginBottom="24dp" />

        <!-- Gratulacje -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GRATULACJE!\nUkończyłeś moduł\n„Bezpieczne wiadomości”\nz świetnym rezultatem!\n\nNaciśnij „Powrót do menu głównego” i kontynuuj naukę w pozostałych modułach!"
            android:background="#BFDBFE"
            android:gravity="center"
            android:padding="24dp"
            android:textSize="20sp"
            android:layout_marginBottom="32dp" />

        <!-- Przycisk POWRÓT DO MENU GŁÓWNEGO -->
        <Button
            android:id="@+id/backToMenuButton"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Powrót do menu głównego"
            android:padding="10dp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
