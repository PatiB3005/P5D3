<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F0FA">

    <!-- ====== GŁÓWNA TREŚĆ (scroll) ====== -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <!-- Tytuł -->
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI-lite"
                android:textStyle="bold"
                android:textSize="36sp"
                android:textColor="#000000"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"/>

            <!-- Opis -->
            <TextView
                android:id="@+id/textContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wybierz, czy zdjęcie jest prawdziwe, czy zostało stworzone przez sztuczną inteligencję"
                android:textSize="20sp"
                android:textColor="#1A202C"
                android:lineSpacingExtra="6dp"
                android:gravity="center"
                android:fontFamily="@font/montserrat_regular"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/photoCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@android:color/transparent"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/aiPhotoImage"
                    android:layout_width="420dp"
                    android:layout_height="520dp"
                    android:src="@drawable/banan"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true" />

            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>
    </ScrollView>

    <!-- ====== DÓŁ EKRANU (przyciski jak na mockupie) ====== -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Dwa przyciski obok siebie -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReal"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Prawdziwe"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#12B76A"
                app:cornerRadius="16dp"
                android:layout_marginEnd="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFake"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="AI"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D92D20"
                app:cornerRadius="16dp"
                android:layout_marginStart="10dp"/>
        </LinearLayout>

        <!-- Przejdź dalej (pokazuje się po wyborze) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="Przejdź dalej"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2B6CB0"
            app:cornerRadius="16dp"
            android:visibility="gone" />
    </LinearLayout>

    <include
        android:id="@+id/popupOverlay"
        layout="@layout/view_result_popup"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
