<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5"
    tools:context=".ui.notifications.NotificationsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="#2B6CB0"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title=""
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Tytuł: większy -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Przypomnienia"
        android:textColor="#1A202C"
        android:textSize="46sp"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toTopOf="@id/bottomContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="34dp"
            android:paddingBottom="12dp">

            <!-- KAFEL: LEKI -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMeds"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:text="Leki"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                app:backgroundTint="#2B6CB0"
                app:cornerRadius="28dp"
                app:icon="@android:drawable/ic_menu_info_details"
                app:iconGravity="textStart"
                app:iconPadding="18dp"
                app:iconSize="34dp"
                android:layout_marginBottom="16dp"/>

            <!-- KAFEL: WIZYTY -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVisits"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:text="Wizyty u lekarza"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                app:backgroundTint="#2B6CB0"
                app:cornerRadius="28dp"
                app:icon="@android:drawable/ic_menu_my_calendar"
                app:iconGravity="textStart"
                app:iconPadding="18dp"
                app:iconSize="34dp"
                android:layout_marginBottom="16dp"/>

            <!-- KAFEL: ZAKUPY -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShopping"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:text="Lista zakupów"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                app:backgroundTint="#2B6CB0"
                app:cornerRadius="28dp"
                app:icon="@android:drawable/ic_menu_agenda"
                app:iconGravity="textStart"
                app:iconPadding="18dp"
                app:iconSize="34dp"
                android:layout_marginBottom="16dp"/>

            <!-- KAFEL: INNE -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOther"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:text="Inne wydarzenia"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                app:backgroundTint="#2B6CB0"
                app:cornerRadius="28dp"
                app:icon="@android:drawable/ic_menu_today"
                app:iconGravity="textStart"
                app:iconPadding="18dp"
                app:iconSize="34dp"
                android:layout_marginBottom="14dp"/>

            <ListView
                android:id="@+id/listReminders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="#D7DEE8"
                android:dividerHeight="1dp"
                android:padding="6dp"
                android:clipToPadding="false"
                tools:listitem="@layout/item_reminder_row"/>

        </LinearLayout>
    </ScrollView>

    <!-- Dół: większy przycisk, tekst może być w 2 wierszach, plus po lewej i na środku -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="22dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:text="Dodaj\nprzypomnienie"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center_vertical|start"
            android:lineSpacingExtra="2dp"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="38dp"
            app:icon="@android:drawable/ic_input_add"
            app:iconGravity="textStart"
            app:iconPadding="20dp"
            app:iconSize="30dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
