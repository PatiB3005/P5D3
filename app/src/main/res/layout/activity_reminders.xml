<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5"
    tools:context=".ui.notifications.NotificationsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="#2B6CB0"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title=""
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- HEADER (trzyma tytuł i gwarantuje dystans) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#E9EEF5"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="22dp"
            android:autoSizeMaxTextSize="32sp"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center"

            android:includeFontPadding="true"
            android:maxLines="2"

            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Przypomnienia"
            android:textColor="#1A202C"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottomContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMeds"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:text="Leki"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                app:backgroundTint="#2B6CB0"
                app:cornerRadius="26dp"
                app:icon="@android:drawable/ic_menu_info_details"
                app:iconGravity="textStart"
                app:iconPadding="14dp"
                app:iconSize="28dp"
                android:layout_marginBottom="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVisits"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:text="Wizyty u lekarza"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                app:backgroundTint="#2B6CB0"
                app:cornerRadius="26dp"
                app:icon="@android:drawable/ic_menu_my_calendar"
                app:iconGravity="textStart"
                app:iconPadding="14dp"
                app:iconSize="28dp"
                android:layout_marginBottom="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShopping"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:text="Lista zakupów"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                app:backgroundTint="#2B6CB0"
                app:cornerRadius="26dp"
                app:icon="@android:drawable/ic_menu_agenda"
                app:iconGravity="textStart"
                app:iconPadding="14dp"
                app:iconSize="28dp"
                android:layout_marginBottom="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOther"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:text="Inne wydarzenia"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                app:backgroundTint="#2B6CB0"
                app:cornerRadius="26dp"
                app:icon="@android:drawable/ic_menu_today"
                app:iconGravity="textStart"
                app:iconPadding="14dp"
                app:iconSize="28dp"
                android:layout_marginBottom="12dp"/>

            <ListView
                android:id="@+id/listReminders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="#D7DEE8"
                android:dividerHeight="1dp"
                android:padding="6dp"
                android:clipToPadding="false"
                tools:listitem="@layout/item_reminder_row"/>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:text="Dodaj przypomnienie"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center_vertical|start"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="32dp"
            app:icon="@android:drawable/ic_input_add"
            app:iconGravity="textStart"
            app:iconPadding="14dp"
            app:iconSize="26dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
