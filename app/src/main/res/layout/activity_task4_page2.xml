<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="80dp">

            <ImageView
                android:id="@+id/imgMessage"
                android:layout_width="0dp"
                android:layout_height="310dp"
                android:src="@drawable/ic_energa"
                android:scaleType="fitCenter"
                android:layout_marginStart="36dp"
                android:layout_marginEnd="36dp"
                android:layout_marginTop="75dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/hintAnswers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Możesz zaznaczyć jedną lub dwie odpowiedzi, potem naciśnij „Sprawdź odpowiedź”."
                android:textSize="20sp"
                android:textColor="#4A5568"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:layout_marginTop="18dp"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                app:layout_constraintTop_toBottomOf="@id/imgMessage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAmount"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:text="Numer klienta"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#000"
                android:textAllCaps="false"
                android:backgroundTint="#A7D0FF"
                app:cornerRadius="28dp"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/hintAnswers"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSender"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:text="Nadawca"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#000"
                android:textAllCaps="false"
                android:backgroundTint="#A7D0FF"
                app:cornerRadius="28dp"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                android:layout_marginTop="55dp"
                app:layout_constraintTop_toBottomOf="@id/btnAmount"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLink"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:text="Link do płatności"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#000"
                android:textAllCaps="false"
                android:backgroundTint="#A7D0FF"
                app:cornerRadius="28dp"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                android:layout_marginTop="55dp"
                app:layout_constraintTop_toBottomOf="@id/btnSender"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheck"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="Sprawdź odpowiedź"
                android:textSize="22sp"
                android:textAllCaps="false"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2B6CB0"
                android:layout_marginTop="30dp"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                app:cornerRadius="16dp"
                app:layout_constraintTop_toBottomOf="@id/btnLink"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                android:layout_width="180dp"
                android:layout_height="58dp"
                android:text="Dalej"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:backgroundTint="#2B6CB0"
                android:elevation="0dp"
                app:cornerRadius="24dp"
                android:visibility="gone"
                android:layout_marginTop="56dp"
                android:layout_marginEnd="40dp"
                app:layout_constraintTop_toBottomOf="@id/btnCheck"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <include
        android:id="@+id/popupOverlay"
        layout="@layout/view_result_popup"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
