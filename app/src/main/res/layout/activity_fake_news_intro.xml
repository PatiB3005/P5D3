<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <!-- Toolbar ze strzałką wstecz -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#4F46E5"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="32dp"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/imageIntroFakeNews"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/fake_news"
                android:contentDescription="Ikona fake news"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/titleIntro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quiz z nagłówków"
                android:textColor="#0F172A"
                android:textSize="30sp"
                android:fontFamily="@font/montserrat_bold"
                android:layout_marginBottom="12dp"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/subTitleIntro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Czy potrafisz odróżnić prawdziwą wiadomość od fake newsa?"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:fontFamily="@font/montserrat_regular"
                android:layout_marginBottom="24dp"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/rulesText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Zobaczysz nagłówki z internetu.\n\n• Zastanów się, czy brzmią wiarygodnie.\n\n• Wybierz TAK – jeśli uważasz, że informacja jest prawdziwa.\n• Wybierz NIE – jeśli podejrzewasz fake newsa.\n\nPo każdej odpowiedzi pokażemy krótkie wyjaśnienie."
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:fontFamily="@font/montserrat_regular"
                android:layout_marginBottom="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartQuiz"
                android:layout_width="200dp"
                android:layout_height="56dp"
                android:text="Zacznij quiz"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:fontFamily="@font/montserrat_bold"
                app:backgroundTint="#4F46E5"
                app:cornerRadius="18dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
