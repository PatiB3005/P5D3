<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#E9EEF5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- OBRAZEK -->
        <ImageView
            android:id="@+id/headerImage"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_mortarboard"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:contentDescription="@null" />

        <!-- TYTUŁ -->
        <TextView
            android:id="@+id/textTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POUCZENIE"
            android:textSize="34sp"
            android:textColor="#000000"
            android:fontFamily="@font/montserrat_bold"
            android:layout_marginBottom="24dp" />

        <!-- ITEM 1 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#D9E2EF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#E7F0FF">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="✓"
                        android:textSize="22sp"
                        android:textColor="#2B6CB0"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Policja nigdy nie prosi o przekazanie pieniędzy ani wypłatę z banku."
                    android:textSize="18sp"
                    android:textColor="#1A202C"
                    android:lineSpacingExtra="6dp"
                    android:fontFamily="@font/montserrat_regular" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ITEM 2 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#D9E2EF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#E7F0FF">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="✓"
                        android:textSize="22sp"
                        android:textColor="#2B6CB0"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Jeśli ktoś mówi, żeby się „nie rozłączać” – rozłącz się (czerwona słuchawka!) i sam zadzwoń na 112 lub do banku."
                    android:textSize="18sp"
                    android:textColor="#1A202C"
                    android:lineSpacingExtra="6dp"
                    android:fontFamily="@font/montserrat_regular" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ITEM 3 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#D9E2EF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#E7F0FF">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="✓"
                        android:textSize="22sp"
                        android:textColor="#2B6CB0"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Nie podawaj nazwy banku, PIN-u ani żadnych danych."
                    android:textSize="18sp"
                    android:textColor="#1A202C"
                    android:lineSpacingExtra="6dp"
                    android:fontFamily="@font/montserrat_regular" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ITEM 4 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#D9E2EF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#E7F0FF">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="✓"
                        android:textSize="22sp"
                        android:textColor="#2B6CB0"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Nie wypłacaj gotówki na polecenie telefoniczne"
                    android:textSize="18sp"
                    android:textColor="#1A202C"
                    android:lineSpacingExtra="6dp"
                    android:fontFamily="@font/montserrat_regular" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ITEM 5 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#D9E2EF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#E7F0FF">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="✓"
                        android:textSize="22sp"
                        android:textColor="#2B6CB0"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="Powiedz rodzinie lub sąsiadom, jeśli dostaniesz taki telefon."
                    android:textSize="18sp"
                    android:textColor="#1A202C"
                    android:lineSpacingExtra="6dp"
                    android:fontFamily="@font/montserrat_regular" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PRZYCISK -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinish"
            android:layout_width="250dp"
            android:layout_height="74dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:text="Zakończ"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:fontFamily="@font/montserrat_bold"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="24dp"/>

    </LinearLayout>

</ScrollView>
