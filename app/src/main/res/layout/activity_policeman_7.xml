<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <!-- Nagłówek SCENARIUSZ -->
    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SCENARIUSZ"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Ikona czapki -->
    <ImageView
        android:id="@+id/imgHat"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_mortarboard"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/textTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Nagłówek "POUCZENIE" -->
    <TextView
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="POUCZENIE"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#C9E4FF"
        android:padding="14dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/imgHat"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Duży blok z zasadami -->
    <TextView
        android:id="@+id/textInfo"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:background="#D8E8FF"
        android:padding="16dp"
        android:textSize="16sp"
        android:textColor="#000000"
        android:text="• Policja nigdy nie prosi o przekazanie pieniędzy ani wypłatę z banku.\n\n• Jeśli ktoś mówi, żeby się „nie rozłączać” – rozłącz się (czerwona słuchawka!) i sam zadzwoń na 112 lub do banku.\n\n• Nie podawaj nazwy banku, PIN-u ani żadnych danych.\n\n• Nie wypłacaj gotówki na polecenie telefoniczne.\n\n• Powiedz rodzinie lub sąsiadom, jeśli dostaniesz taki telefon."
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Czerwony przycisk Zakończ -->
    <Button
        android:id="@+id/btnFinish"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:text="Zakończ"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#D80000"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/textInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
