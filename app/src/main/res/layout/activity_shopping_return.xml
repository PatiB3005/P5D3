<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:clipToPadding="false"
    android:paddingBottom="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="22dp"
        android:paddingBottom="12dp">

        <!-- Nagłówek modułu (TREŚĆ BEZ ZMIAN) -->
        <TextView
            android:id="@+id/titleModule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ZAKUPY ONLINE"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="false"
            android:textColor="#1A202C"
            android:textSize="36sp"
            android:fontFamily="@font/montserrat_bold"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp" />

        <!-- Medal (TREŚĆ/OBRAZ BEZ ZMIAN) - bez białej karty -->
        <ImageView
            android:id="@+id/finishMedal"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:src="@drawable/ic_sad_emoji"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="Srebrny medal za ukończenie modułu"
            android:layout_marginBottom="16dp" />

        <!-- Gratulacje (TREŚĆ BEZ ZMIAN) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/congratsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="30dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#BFDBFE"
            app:strokeWidth="1dp"
            app:strokeColor="#A7C7F7"
            android:stateListAnimator="@null">

            <TextView
                android:id="@+id/congratsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="O NIE!\nNiestety nie przyswoiłeś wiedzy z tego modułu zbyt dobrze.\n\nNaciśnij „Powrót do menu głównego”, aby kontynuować naukę w pozostałych modułach lub „Powtórz moduł”, żeby przećwiczyć materiał przed kolejnym testem!"
                android:textSize="20sp"
                android:textColor="#1A202C"
                android:gravity="center"
                android:textAlignment="center"
                android:includeFontPadding="false"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:lineSpacingExtra="5dp"
                android:fontFamily="@font/montserrat_regular" />
        </com.google.android.material.card.MaterialCardView>

        <!-- PRZYCISKI: jeden pod drugim (żeby tekst się mieścił) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/backToMenuButton"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:text="Powrót do menu głównego"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeStepGranularity="1sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:cornerRadius="24dp"
            app:backgroundTint="#2B6CB0"
            app:rippleColor="#00000000"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryTestButton"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:text="Powtórz test"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeStepGranularity="1sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:cornerRadius="24dp"
            app:backgroundTint="#2B6CB0"
            app:rippleColor="#00000000"
            android:elevation="0dp"
            android:stateListAnimator="@null" />

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp" />

    </LinearLayout>
</ScrollView>
