<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F0FA">

    <!-- ====== GŁÓWNA TREŚĆ (scroll) ====== -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <!-- Tytuł -->
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI-lite"
                android:textStyle="bold"
                android:textSize="36sp"
                android:textColor="#000000"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"/>

            <!-- Opis -->
            <TextView
                android:id="@+id/textContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wybierz, czy zdjęcie jest prawdziwe, czy zostało stworzone przez sztuczną inteligencję"
                android:textSize="20sp"
                android:textColor="#1A202C"
                android:lineSpacingExtra="6dp"
                android:gravity="center"
                android:fontFamily="@font/montserrat_regular"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp"/>

            <!-- Karta na obraz -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/photoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/aiPhotoImage"
                    android:layout_width="match_parent"
                    android:layout_height="520dp"
                    android:src="@drawable/sukienka2"
                    android:scaleType="centerCrop" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- ====== DÓŁ EKRANU (przyciski jak na mockupie) ====== -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Dwa przyciski obok siebie -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReal"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Prawdziwe"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#12B76A"
                app:cornerRadius="16dp"
                android:layout_marginEnd="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFake"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="AI"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D92D20"
                app:cornerRadius="16dp"
                android:layout_marginStart="10dp"/>
        </LinearLayout>

        <!-- Przejdź dalej (pokazuje się po wyborze) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="Przejdź dalej"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2B6CB0"
            app:cornerRadius="16dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ====== POPUP (overlay) ====== -->
    <LinearLayout
        android:id="@+id/popupOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:visibility="gone"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/popup_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="320dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/titleFalse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:visibility="visible"
                android:textStyle="bold"
                android:text="Niepoprawna odpowiedź"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#1A202C"
                android:gravity="center"
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/titleTrue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:visibility="gone"
                android:textStyle="bold"
                android:text="Poprawna odpowiedź"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#1A202C"
                android:gravity="center"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:text="To zdjęcie jest prawdziwe, ponieważ:"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:textColor="#4A5568"
                android:layout_marginBottom="18dp" />

            <LinearLayout
                android:id="@+id/popupList"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:text="• Nierealistyczne fałdy materiału - Spódnica ma idealnie gładkie, “malarskie” przejścia cieni i bardzo czyste, szerokie fale. W prawdziwej tkaninie zwykle widać więcej drobnych zagnieceń i mniej perfekcyjnie równych gradientów."
                    android:fontFamily="@font/montserrat_regular"
                    android:textColor="#4A5568"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:text="• Postać jest “niekompletna” – u góry brakuje szyi i głowy, a u dołu jest jedna noga, jakby obraz urwało albo “zgubiło” anatomię. To bardzo częsty błąd generacji AI."
                    android:fontFamily="@font/montserrat_regular"
                    android:textColor="#4A5568"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:text="• Podejrzana spójność światła - Całość (sukienka + sofa + dodatki) ma bardzo “katalogowe”, równe oświetlenie bez drobnych niedoskonałości i cieni kontaktowych typowych dla prawdziwego zdjęcia."
                    android:fontFamily="@font/montserrat_regular"
                    android:textColor="#4A5568"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:text="• Scena jest zbyt “katalogowa” – wszystko jest perfekcyjnie czyste, bez drobnych niedoskonałości; takie obrazy AI często wyglądają jak idealna reklama."
                    android:fontFamily="@font/montserrat_regular"
                    android:textColor="#4A5568"
                    android:layout_marginBottom="8dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOk"
                android:layout_width="200dp"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:text="OK"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:backgroundTint="#2B6CB0"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
