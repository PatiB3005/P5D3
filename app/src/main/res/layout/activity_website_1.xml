<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">

    <!-- GÓRNA CZĘŚĆ (tytuły) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Moduł"
            android:textSize="36sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Strony"
            android:textSize="36sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ONLINE\nZAKUPY"
            android:textSize="40sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>


    <!-- ŚRODEK (OBRAZ) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:gravity="center">

        <ImageView
            android:id="@+id/imageShopping"
            android:layout_width="300dp"
            android:layout_height="200dp"
            android:src="@drawable/online_shopping"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />
    </LinearLayout>


    <!-- DÓŁ (TEKST + PRZYCISK) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top|center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Przeanalizuj stronę i wskaż\nwszystkie zauważone\nniebezpieczeństwa"
            android:textSize="24sp"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ROZPOCZNIJ"
            android:textStyle="bold"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:backgroundTint="#D0D3E0"
            android:textColor="#000000" />

    </LinearLayout>

</LinearLayout>
