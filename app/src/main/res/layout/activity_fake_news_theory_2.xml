<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <!-- SCROLL -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- CONTENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="20dp">

            <!-- FAKE NEWS -->
            <TextView
                android:id="@+id/headerMain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FAKE NEWS"
                android:textColor="#1A202C"
                android:textSize="32sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:layout_marginBottom="6dp"/>

            <!-- CZYM SĄ -->
            <TextView
                android:id="@+id/headerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CZYM SĄ?"
                android:textColor="#1A202C"
                android:textSize="28sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <!-- CZĘŚĆ TEORETYCZNA -->
            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Część teoretyczna"
                android:textColor="#4A5568"
                android:textSize="22sp"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:layout_marginBottom="20dp"/>

            <!-- OBRAZ -->
            <ImageView
                android:id="@+id/headerImage"
                android:layout_width="280dp"
                android:layout_height="160dp"
                android:src="@drawable/ic_fake_news_1"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:layout_marginBottom="20dp"/>

            <!-- TEKST -->
            <TextView
                android:id="@+id/contentText1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/blue_box_radius"
                android:padding="18dp"
                android:textSize="22sp"
                android:lineSpacingExtra="7dp"
                android:textColor="#1A202C"
                android:fontFamily="@font/montserrat_regular"
                android:text="Fake newsy to wiadomości, które wyglądają jak prawdziwe, ale wprowadzają w błąd. Czasem są całkiem zmyślone, a czasem zawierają półprawdę lub przekręcone fakty. Ich celem bywa wywołanie emocji, zdobycie kliknięć albo oszukanie odbiorcy." />

        </LinearLayout>
    </ScrollView>

    <!-- DIVIDER -->
    <View
        android:id="@+id/bottomDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#D9E2EF"
        app:layout_constraintBottom_toTopOf="@id/bottomButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BUTTONS -->
    <LinearLayout
        android:id="@+id/bottomButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:layout_weight="1"
            android:text="Wstecz"
            android:textAllCaps="false"
            android:textSize="20sp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="22dp"/>

        <Space
            android:layout_width="14dp"
            android:layout_height="1dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:layout_weight="1"
            android:text="Dalej"
            android:textAllCaps="false"
            android:textSize="20sp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="22dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
