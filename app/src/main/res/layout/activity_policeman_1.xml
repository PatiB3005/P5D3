<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5">

    <!-- Tytuł SCENARIUSZ -->
    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SCENARIUSZ"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Niebieska ikona kontaktu -->
    <ImageView
        android:id="@+id/imgContact"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/ic_contact"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/textTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tekst NIEZNANY NUMER -->
    <TextView
        android:id="@+id/textUnknown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NIEZNANY NUMER"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/imgContact"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Zielona ikona telefonu -->
    <ImageView
        android:id="@+id/imgCall"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:src="@drawable/ic_call"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/textUnknown"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tekst: Naciśnij, aby odebrać -->
    <TextView
        android:id="@+id/textClick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Naciśnij, aby odebrać"
        android:textSize="18sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/imgCall"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnEnd"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="Koniec"
        android:textSize="16sp"
        android:backgroundTint="#C6C9D1"
        android:textColor="#000000"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/textClick"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>



</androidx.constraintlayout.widget.ConstraintLayout>
