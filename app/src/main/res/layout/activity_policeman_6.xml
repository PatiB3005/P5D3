<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#E9EEF5">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Tytuł -->
        <TextView
            android:id="@+id/textTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:text="SYMULACJA\nROZMOWY"
            android:gravity="center"
            android:fontFamily="@font/montserrat_bold"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Wiadomość -->
        <TextView
            android:id="@+id/textMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Po wypłacie proszę przekazać pieniądze policjantowi, który się z Panią
skontaktuje.
Ma odznakę i legitymację"
            android:textSize="22sp"
            android:textColor="#000000"
            android:lineSpacingExtra="4dp"
            android:padding="24dp"
            android:fontFamily="@font/montserrat_regular"
            android:background="@drawable/edittext_bg"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/textTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Avatar -->
        <ImageView
            android:id="@+id/imgPoliceman"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_policeman"
            android:background="@drawable/full_rounded_image"
            android:layout_marginTop="12dp"
            android:layout_marginStart="48dp"
            app:layout_constraintTop_toBottomOf="@id/textMessage"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Pytania i odpowiedzi -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/question"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@+id/imgPoliceman"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- PRZYCISK -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:text="Przejdź dalej"
                android:textAllCaps="false"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/montserrat_bold"
                app:backgroundTint="#2B6CB0"
                app:cornerRadius="28dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>