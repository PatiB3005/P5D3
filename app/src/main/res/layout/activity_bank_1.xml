<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF3FF">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SCENARIUSZ"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- duża ikona kontaktu -->
    <ImageView
        android:id="@+id/imgContact"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/ic_contact"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bank – Infolinia -->
    <TextView
        android:id="@+id/textUnknown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bank – Infolinia\n(numer nieznany)"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/imgContact"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- zielona słuchawka -->
    <ImageView
        android:id="@+id/imgCall"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:src="@drawable/ic_call"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/textUnknown"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textClick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Naciśnij, aby odebrać"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/imgCall"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- przycisk wyjścia z modułu -->
    <Button
        android:id="@+id/btnEnd"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="Koniec"
        android:textSize="16sp"
        android:backgroundTint="#C6C9D1"
        android:textColor="#000000"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/textClick"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
