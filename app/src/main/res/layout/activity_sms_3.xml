<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EEF5"
    tools:context=".ui.moduleMenu.modules.SmsEmailActivity">

    <ImageButton
        android:id="@+id/btnTTS"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/tts_off"
        android:padding="8dp"
        android:src="@drawable/ic_volume_off"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- WAŻNE: match_parent, żeby constraints mogły “dociągnąć” kafelek do dołu -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/titleSafeMessages"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Bezpieczne\nwiadomości"
                android:textColor="#1A202C"
                android:textSize="36sp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:textAlignment="center"
                android:includeFontPadding="false"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/titleTestPart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Część testowa"
                android:textColor="#4A5568"
                android:textSize="24sp"
                android:fontFamily="@font/montserrat_regular"
                android:gravity="center"
                android:textAlignment="center"
                android:includeFontPadding="false"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/titleSafeMessages"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- KARTA #1 (opis sytuacji) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuestion1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                android:stateListAnimator="@null"
                app:cardBackgroundColor="#A5CCFF"
                app:layout_constraintTop_toBottomOf="@id/titleTestPart"
                app:layout_constraintBottom_toTopOf="@id/cardQuestion2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_chainStyle="spread_inside">

                <TextView
                    android:id="@+id/question1Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:text="Dzwoni do Ciebie osoba podająca się za pracownika banku i mówi, że Twoje konto jest zagrożone. Prosi, abyś podał(a) dane lub wykonał(a) pilne polecenia."
                    android:textSize="26sp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="#1A202C"
                    android:fontFamily="@font/montserrat_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- KARTA #2 (pytanie + TAK/NIE) — siedzi niżej, bez pustki -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuestion2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                android:stateListAnimator="@null"
                app:cardBackgroundColor="#BFDBFE"
                app:strokeWidth="1dp"
                app:strokeColor="#A7C7F7"
                app:layout_constraintTop_toBottomOf="@id/cardQuestion1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="22dp">

                    <TextView
                        android:id="@+id/question2Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Czy powinieneś wykonać polecenia osoby dzwoniącej?"
                        android:textSize="26sp"
                        android:lineSpacingExtra="6dp"
                        android:textColor="#1A202C"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:includeFontPadding="false"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:baselineAligned="false">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/yesButton"
                            android:layout_width="0dp"
                            android:layout_height="86dp"
                            android:layout_weight="1"
                            android:text="TAK"
                            android:textAllCaps="false"
                            android:textSize="26sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#2B6CB0"
                            app:cornerRadius="26dp"
                            app:rippleColor="#00000000"
                            android:elevation="0dp"
                            android:stateListAnimator="@null"
                            android:layout_marginEnd="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/noButton"
                            android:layout_width="0dp"
                            android:layout_height="86dp"
                            android:layout_weight="1"
                            android:text="NIE"
                            android:textAllCaps="false"
                            android:textSize="26sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="#2B6CB0"
                            app:cornerRadius="26dp"
                            app:rippleColor="#00000000"
                            android:elevation="0dp"
                            android:stateListAnimator="@null"
                            android:layout_marginStart="12dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
